{
  "name": "swift",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "db:generate": "cd apps/api && npx prisma generate",
    "db:migrate": "cd apps/api && npx prisma migrate dev",
    "db:seed": "cd apps/api && npx prisma db seed",
    "db:sync": "cd apps/api && npx prisma db push --skip-generate",
    "db:studio": "cd apps/api && npx prisma studio",
    "fix:env": "cd apps/api && npx prisma db push --skip-generate && npx prisma db seed"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "turbo": "^2.9.17",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "meilisearch": "^0.56.0"
  },
  "pnpm": {
    "overrides": {
      "shell-quote@<1.9.0": ">=1.9.0",
      "engine.io@>=4.1.0 <6.6.7": ">=6.6.7",
      "fast-uri@<3.1.1": ">=3.1.1",
      "ws@>=8.0.0 <8.20.1": ">=8.20.1",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "lodash@<4.18.0": ">=4.18.0",
      "defu@<6.1.5": ">=6.1.5",
      "tmp@<0.2.6": ">=0.2.6",
      "picomatch@>=2.0.0 <2.3.2": ">=2.3.2",
      "node-forge@<1.4.0": ">=1.4.0",
      "form-data@<4.0.6": ">=4.0.6",
      "ws@>=7.0.0 <7.5.11": ">=7.5.11",
      "effect@<3.20.0": ">=3.20.0",
      "vite@>=8.0.0 <=8.0.15": ">=8.0.16",
      "js-yaml@<=4.1.1": ">=4.2.0 <5",
      "@babel/core": "^7.29.6",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "postcss@<8.5.10": ">=8.5.10",
      "uuid@<11.1.1": ">=11.1.1",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2",
      "brace-expansion@<1.1.16": ">=1.1.16 <2",
      "brace-expansion@>=2.0.0 <2.1.2": ">=2.1.2 <3",
