{
  "name": "swift",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo run type-check lint test",
    "clean": "turbo clean",
    "db:generate": "cd apps/api && npx prisma generate",
    "db:migrate": "cd apps/api && npx prisma migrate dev",
    "db:seed": "cd apps/api && npx prisma db seed",
    "db:sync": "cd apps/api && npx prisma db push --skip-generate",
    "db:studio": "cd apps/api && npx prisma studio",
    "fix:env": "cd apps/api && npx prisma db push --skip-generate && npx prisma db seed"
  },
  "devDependencies": {
