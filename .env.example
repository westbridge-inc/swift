# ─── DATABASE ───
DATABASE_URL=postgresql://swift:swift@localhost:5432/swift
REDIS_URL=redis://localhost:6379

# ─── AUTH ───
JWT_SECRET=your-jwt-secret-change-me
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-me

# ─── GOOGLE MAPS ───
GOOGLE_MAPS_API_KEY_IOS=
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_BACKEND=

# ─── FIREBASE ───
FIREBASE_PROJECT_ID=swift-gy
FIREBASE_SERVER_KEY=

# ─── NOTIFICATIONS / SMS (OTP) ───
# 'dev' logs to memory (default; local + tests). 'twilio' sends real SMS.
NOTIFICATION_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ─── FILE STORAGE ───
# 'local' (default, dev) or 's3'/'r2' (set AWS_S3_ENDPOINT + path-style for R2)
STORAGE_PROVIDER=local
AWS_S3_BUCKET=swift-media
AWS_S3_ENDPOINT=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_SIGNING_SECRET=dev-signing-secret
API_PUBLIC_URL=

# ─── PAYMENTS ───
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=

# ─── PROVIDER SELECTORS (swappable seams; defaults are dev/sandbox) ───
MAPS_PROVIDER=haversine
# KYC: 'sandbox' (manual review) or 'idanalyzer' (idanalyzer.com — OCR + face match)
KYC_PROVIDER=sandbox
ID_ANALYZER_API_KEY=
ID_ANALYZER_API_URL=https://api2.idanalyzer.com
PAYMENT_PROVIDER=sandbox

# ─── APP CONFIG ───
PORT=3000
NODE_ENV=development
CORS_ORIGIN=
