[Unit]
Description=Swift secrets: decrypt the host credential store onto tmpfs for the containers
Documentation=file:/opt/swift/deploy/PILOT-RUNBOOK.md
# The containers restart with Docker at boot and read /run/secrets at start,
# so the files must exist first. Ordering only: a failure here never stops
# Docker; the app then refuses to boot with a clear "could not be read" and
# `systemctl status swift-secrets.service` says why.
After=local-fs.target
Before=docker.service
ConditionPathIsDirectory=/etc/credstore.encrypted/swift

[Service]
Type=oneshot
# Stays "active" after the run, so `systemctl restart swift-secrets.service`
# re-materializes after `swift-secrets set`, and status shows the last result.
RemainAfterExit=yes
ExecStart=/usr/local/sbin/swift-secrets materialize
# The runtime uid the files are owned by: the API image's `node` user.
Environment=SWIFT_SECRETS_OWNER_UID=1000
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
