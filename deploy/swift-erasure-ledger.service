[Unit]
Description=Swift off-site erasure ledger (ship each erasure's entry, encrypted to the owner's key)
# [Off-site erasure ledger] Every erasure writes its ledger entry in its own transaction; this unit
# sends the unshipped ones to the off-site backup bucket within about a minute. The API pages the
# platform when an entry is still unshipped after 10 minutes, and deploy/doctor.sh FAILs.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=swift-deploy
Group=swift-deploy
SupplementaryGroups=docker
WorkingDirectory=/opt/swift
# Settings only (deploy/.env holds no secret). The storage keys are the backup unit's own encrypted
# credentials; the container-only *_FILE paths from deploy/.env are unset so they win (as in
# swift-backup.service).
EnvironmentFile=/opt/swift/deploy/.env
LoadCredentialEncrypted=AWS_ACCESS_KEY_ID:/etc/credstore.encrypted/swift/AWS_ACCESS_KEY_ID.cred
LoadCredentialEncrypted=AWS_SECRET_ACCESS_KEY:/etc/credstore.encrypted/swift/AWS_SECRET_ACCESS_KEY.cred
UnsetEnvironment=AWS_ACCESS_KEY_ID_FILE AWS_SECRET_ACCESS_KEY_FILE
ExecStart=/opt/swift/deploy/erasure-ledger-ship.sh --project swift
# A hung run must not silence every later minute.
TimeoutStartSec=5min
