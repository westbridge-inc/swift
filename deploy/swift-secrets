#!/usr/bin/env bash
#
# swift-secrets — the encrypted host store for Swift staging/production secrets.
#
#   sudo swift-secrets set NAME       value on STDIN only (never argv, never a file)
#   sudo swift-secrets list           names only (the store's parent is root-only 0700)
#   sudo swift-secrets materialize    decrypt every credential onto tmpfs for the containers
#   sudo swift-secrets backup init      prepare the BACKUP store (see BACKUP STORE below)
#   sudo swift-secrets backup set-keys  the backup bucket's own key pair, two lines on STDIN
#   sudo swift-secrets backup list      names, and which storage key the backups use
#
# AT REST   /etc/credstore.encrypted/swift/NAME.cred, written by
#           `systemd-creds encrypt --with-key=host --name=NAME`, root 0600.
#           The key is this host's /var/lib/systemd/credential.secret (root
#           0400): the files decrypt nowhere else and for nobody but root here.
#           Overwriting keeps the previous version as NAME.cred.prev.
# IN USE    /run/swift-secrets/NAME — plaintext on tmpfs (never a disk), mode
#           0400, owned by the container runtime uid (SWIFT_SECRETS_OWNER_UID,
#           default 1000 = the API image's `node` user); directory 0500, same
#           owner. Compose bind-mounts the directory read-only at /run/secrets
#           and the app reads NAME_FILE=/run/secrets/NAME
#           (apps/api/src/utils/secret-files.ts). The postgres image reads its
#           *_FILE as root before dropping privileges; the search image reads
#           its file inside its own shell.
# NEVER     a value in argv (ps, audit logs), in a container's environment
#           (`docker inspect`, the container config on disk), in deploy/.env,
#           in git, in a backup, in a log, or on a screen.
#
# Honest threat model: this defeats file, backup, log and Docker-config leaks
# and casual reads. It does NOT defeat root on this host, and without a TPM a
# full-disk snapshot plus root recovers the host key — so snapshots are
# sensitive, and every stored credential stays revocable and least-privilege.
#
# BACKUP STORE [SEC-BACKUP F1/F2] /etc/credstore.encrypted/swift-backup/ holds
#           what only the host's backup, erasure-ledger and restore units may
#           hold: BACKUP_AWS_ACCESS_KEY_ID + BACKUP_AWS_SECRET_ACCESS_KEY (a
#           key limited to the backup bucket), BACKUP_KEY_SOURCE (`dedicated`,
#           or `shared-api-key` while that pair is still a copy of the API's
#           storage key) and BACKUP_SIGNING_KEY (the ed25519 key every dump is
#           signed with; its PUBLIC half is appended to the allowed-signers
#           file restores verify against, /etc/swift/backup-allowed-signers).
#           `materialize` never reads this directory, so the api and worker
#           containers can never see any of it; `set` refuses BACKUP_* names
#           and `materialize` skips one planted in the main store.
#
# swift-secrets.service runs `materialize` at boot, before Docker. After a
# `set`, run `sudo systemctl restart swift-secrets.service` and restart the app
# (deploy/pilot-up.sh does both).
set -euo pipefail

STORE_DIR="${SWIFT_SECRETS_STORE_DIR:-/etc/credstore.encrypted/swift}"
RUN_DIR="${SWIFT_SECRETS_RUN_DIR:-/run/swift-secrets}"
BACKUP_STORE_DIR="${SWIFT_SECRETS_BACKUP_STORE_DIR:-/etc/credstore.encrypted/swift-backup}"
ALLOWED_SIGNERS="${SWIFT_SECRETS_ALLOWED_SIGNERS:-/etc/swift/backup-allowed-signers}"
# The backup store's names, and the only ones it holds.
BACKUP_NAMES="BACKUP_AWS_ACCESS_KEY_ID BACKUP_AWS_SECRET_ACCESS_KEY BACKUP_KEY_SOURCE BACKUP_SIGNING_KEY"
OWNER_UID="${SWIFT_SECRETS_OWNER_UID:-1000}"
OWNER_GID="${SWIFT_SECRETS_OWNER_GID:-$OWNER_UID}"
NAME_RE='^[A-Z][A-Z0-9_]{0,127}$'
STAGE_DIR=""

usage() {
  cat >&2 <<'USAGE'
usage: swift-secrets set NAME          (value on stdin:  printf '%s' VALUE | sudo swift-secrets set NAME)
       swift-secrets list
       swift-secrets materialize
       swift-secrets backup init      (the backup store: fallback storage key copy, signing key)
       swift-secrets backup set-keys  (stdin: the backup bucket's access key id, newline, its secret)
       swift-secrets backup list
USAGE
  exit 2
}
die() { echo "swift-secrets: $*" >&2; exit 1; }
require_root() { [ "$(id -u)" -eq 0 ] || die "$1 must run as root (sudo swift-secrets $1)"; }
valid_name() { [[ "$1" =~ $NAME_RE ]] && [[ "$1" != *_FILE ]]; }
is_backup_name() { [[ "$1" == BACKUP_* ]]; }

# store_value DIR NAME — encrypt stdin as NAME into DIR (0600), keeping the
# previous version as NAME.cred.prev; the live file is replaced by ONE rename.
store_value() {
  local dir="$1" name="$2" tmp cred
  umask 077
  cred="$dir/$name.cred"
  tmp="$dir/.$name.$$.tmp"
  rm -f -- "${tmp:?}"
  systemd-creds encrypt --with-key=host --name="$name" - "$tmp" ||
    { rm -f -- "${tmp:?}"; die "systemd-creds could not encrypt $name"; }
  chmod 0600 "$tmp"
  if [ -e "$cred" ]; then
    cp -p "$cred" "$cred.prev"
    chmod 0600 "$cred.prev"
  fi
  mv -f "$tmp" "$cred"
}

cmd_set() {
  [ $# -eq 1 ] || usage
  local name="$1" value tmp cred
  valid_name "$name" || die "NAME must be UPPER_CASE ($NAME_RE) and not end in _FILE"
  # [SEC-BACKUP F1] The main store is materialized for the containers: a backup
  # credential never goes there.
  if is_backup_name "$name"; then
    die "$name belongs to the backup store, which the containers never see: use  sudo swift-secrets backup set-keys  (or backup init)"
  fi
  require_root set
  [ ! -t 0 ] || die "the value is read from stdin, never typed here:  printf '%s' VALUE | sudo swift-secrets set $name"
  # Read stdin whole (the sentinel keeps trailing newlines), then drop exactly
  # one trailing newline so `echo value |` and `printf '%s' value |` store the
  # same bytes.
  value="$(cat; printf x)"
  value="${value%x}"
  # Exactly one trailing line ending goes — "\r\n" or "\n" — mirroring the
  # app's loader, so a value pasted with a Windows ending round-trips.
  if [[ "$value" == *$'\n' ]]; then
    value="${value%$'\n'}"
    value="${value%$'\r'}"
  fi
  [ -n "$value" ] || die "empty value on stdin; nothing stored"
  umask 077
  install -d -m 0755 "$STORE_DIR"
  cred="$STORE_DIR/$name.cred"
  tmp="$STORE_DIR/.$name.$$.tmp"
  rm -f "$tmp"
  printf '%s' "$value" | systemd-creds encrypt --with-key=host --name="$name" - "$tmp" ||
    { rm -f "$tmp"; die "systemd-creds could not encrypt $name"; }
  unset value
  chmod 0600 "$tmp"
  # Keep the previous version by COPY, then swap with ONE rename: the live
  # credential never vanishes, so a materialize running now still sees it.
  if [ -e "$cred" ]; then
    cp -p "$cred" "$cred.prev"
    chmod 0600 "$cred.prev"
  fi
  mv -f "$tmp" "$cred"
  echo "stored $name"
}

cmd_list() {
  [ $# -eq 0 ] || usage
  # A store that EXISTS but cannot be read must never list as empty: every
  # caller (pilot-up's preflight, the owner tools) would then report stored
  # secrets as missing. systemd keeps /etc/credstore.encrypted at 0700, so an
  # unprivileged list cannot see inside it — say so instead of printing nothing.
  # dirname, not ${STORE_DIR%/*}: a trailing slash (".../swift/") must still
  # name the real parent, or an unreadable store would list as empty again.
  local parent
  parent="$(dirname -- "$STORE_DIR")"
  if [ ! -d "$STORE_DIR" ]; then
    if [ -d "$parent" ] && [ ! -x "$parent" ]; then
      die "cannot read the store at $STORE_DIR (it is root-only); run: sudo swift-secrets list"
    fi
    return 0
  fi
  { [ -r "$STORE_DIR" ] && [ -x "$STORE_DIR" ]; } ||
    die "cannot read the store at $STORE_DIR (it is root-only); run: sudo swift-secrets list"
  local f
  for f in "$STORE_DIR"/*.cred; do
    [ -e "$f" ] || continue
    f="${f##*/}"
    echo "${f%.cred}"
  done | sort
}

cmd_materialize() {
  [ $# -eq 0 ] || usage
  require_root materialize
  local parent fstype name cred tmp f count=0
  parent="$(dirname "$RUN_DIR")"
  fstype="$(findmnt -n -o FSTYPE --target "$parent" 2>/dev/null || true)"
  [ "$fstype" = tmpfs ] ||
    die "$parent is on '${fstype:-unknown}', not tmpfs; refusing to write plaintext secrets to a disk"
  umask 077
  install -d "$RUN_DIR"
  chown "$OWNER_UID:$OWNER_GID" "$RUN_DIR"
  # Plaintext is decrypted into a root-only staging directory beside RUN_DIR
  # (same tmpfs, so the move is a rename) and never written through a path the
  # directory owner could have replaced with a symlink. RUN_DIR is writable
  # while this run replaces files and 0500 again on every exit path.
  # (Global on purpose: the EXIT trap below runs after this function returns.)
  STAGE_DIR="$(mktemp -d "$parent/.swift-secrets-stage.XXXXXX")"
  chmod 0700 "$STAGE_DIR"
  chmod 0700 "$RUN_DIR"
  trap 'rm -rf "$STAGE_DIR"; chmod 0500 "$RUN_DIR" 2>/dev/null || true' EXIT
  for f in "$RUN_DIR"/.*.tmp; do { [ -e "$f" ] || [ -L "$f" ]; } && rm -f "$f"; done
  if [ -d "$STORE_DIR" ]; then
    for cred in "$STORE_DIR"/*.cred; do
      [ -e "$cred" ] || continue
      name="${cred##*/}"
      name="${name%.cred}"
      valid_name "$name" || die "refusing a credential with an invalid name: $name"
      # [SEC-BACKUP F1] Never hand a backup credential to the containers, even
      # one copied into the main store by hand. Skipped, not fatal: the app's
      # own secrets must still reach it at boot.
      if is_backup_name "$name"; then
        echo "swift-secrets: WARNING: $name is in the main store, which the containers read; it was NOT materialized. Store it with: sudo swift-secrets backup set-keys, then delete $cred" >&2
        continue
      fi
      tmp="$STAGE_DIR/$name"
      if ! systemd-creds decrypt --name="$name" "$cred" - > "$tmp"; then
        rm -f "$tmp"
        die "could not decrypt $name (wrong host key, or the credential was encrypted under another name)"
      fi
      [ -s "$tmp" ] || { rm -f "$tmp"; die "$name decrypted to an empty value"; }
      chown "$OWNER_UID:$OWNER_GID" "$tmp"
      chmod 0400 "$tmp"
      # Whatever sits at the target is replaced, never followed: a symlink or a
      # directory planted there is removed first (rm does not follow links).
      if [ -L "$RUN_DIR/$name" ] || [ -d "$RUN_DIR/$name" ]; then rm -rf "$RUN_DIR/$name"; fi
      mv -f "$tmp" "$RUN_DIR/$name"
      count=$((count + 1))
    done
  fi
  # Drop whatever the store no longer holds.
  for f in "$RUN_DIR"/*; do
    [ -e "$f" ] || continue
    name="${f##*/}"
    [ -e "$STORE_DIR/$name.cred" ] || rm -f "$f"
  done
  echo "materialized $count secret(s) into $RUN_DIR"
}

# ── BACKUP STORE [SEC-BACKUP] ───────────────────────────────────────────────
backup_source() {
  local cred="$BACKUP_STORE_DIR/BACKUP_KEY_SOURCE.cred"
  [ -e "$cred" ] || { echo none; return 0; }
  systemd-creds decrypt --name=BACKUP_KEY_SOURCE "$cred" - 2>/dev/null || echo unreadable
}

# A root-only scratch directory on tmpfs for plaintext in flight (global: the
# EXIT trap removes it).
backup_scratch() {
  local parent fstype
  parent="$(dirname "$RUN_DIR")"
  fstype="$(findmnt -n -o FSTYPE --target "$parent" 2>/dev/null || true)"
  [ "$fstype" = tmpfs ] ||
    die "$parent is on '${fstype:-unknown}', not tmpfs; refusing to write plaintext keys to a disk"
  STAGE_DIR="$(mktemp -d "$parent/.swift-secrets-backup.XXXXXX")"
  chmod 0700 "$STAGE_DIR"
  trap 'rm -rf -- "${STAGE_DIR:?}"' EXIT
}

# The public half of the signing key goes into the allowed-signers file restores
# verify against. Appended, never rewritten: an older key's dumps keep verifying.
trust_signing_key() {
  local key="$1" pub line
  pub="$(ssh-keygen -y -f "$key")" || die "the backup signing key could not be read"
  set -- $pub
  [ "${1:-}" = ssh-ed25519 ] && [ -n "${2:-}" ] || die "the backup signing key is not an ed25519 key"
  line="swift-backup namespaces=\"swift-backup\" $1 $2"
  install -d -m 0755 "$(dirname "$ALLOWED_SIGNERS")"
  [ -e "$ALLOWED_SIGNERS" ] || : > "$ALLOWED_SIGNERS"
  chmod 0644 "$ALLOWED_SIGNERS"
  grep -qxF -- "$line" "$ALLOWED_SIGNERS" || printf '%s\n' "$line" >> "$ALLOWED_SIGNERS"
}

cmd_backup_init() {
  [ $# -eq 0 ] || usage
  require_root "backup init"
  local source name plain
  umask 077
  install -d -m 0700 "$BACKUP_STORE_DIR"
  backup_scratch
  source="$(backup_source)"
  case "$source" in
    dedicated)
      echo "backup storage key: dedicated (kept)" ;;
    none|shared-api-key)
      # FALLBACK until the owner stores the backup bucket's own key: a copy of
      # the API's pair under the backup names, so backups never stop. Every run
      # that uses it warns, and the API pages until it is replaced.
      for name in AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY; do
        [ -e "$STORE_DIR/$name.cred" ] ||
          die "$name is not in the main store; store the storage keys first (sudo swift-secrets set $name), or the backup bucket's own pair (sudo swift-secrets backup set-keys)"
        plain="$STAGE_DIR/$name"
        systemd-creds decrypt --name="$name" "$STORE_DIR/$name.cred" - > "$plain" || die "could not decrypt $name"
        [ -s "$plain" ] || die "$name decrypted to an empty value"
        store_value "$BACKUP_STORE_DIR" "BACKUP_$name" < "$plain"
        rm -f -- "${plain:?}"
      done
      printf '%s' shared-api-key | store_value "$BACKUP_STORE_DIR" BACKUP_KEY_SOURCE
      echo "swift-secrets: WARNING: backups still share the API's storage key (a copy, stored as BACKUP_AWS_*). Create a key limited to the backup bucket and store it: deploy/owner/swift-backup-key.command" >&2
      echo "backup storage key: shared-api-key (fallback copy)" ;;
    *) die "BACKUP_KEY_SOURCE could not be read; nothing was changed" ;;
  esac
  plain="$STAGE_DIR/signing"
  if [ -e "$BACKUP_STORE_DIR/BACKUP_SIGNING_KEY.cred" ]; then
    systemd-creds decrypt --name=BACKUP_SIGNING_KEY "$BACKUP_STORE_DIR/BACKUP_SIGNING_KEY.cred" - > "$plain" ||
      die "BACKUP_SIGNING_KEY exists but does not decrypt; nothing was changed (a new key would orphan every signed dump)"
    chmod 0600 "$plain"
    trust_signing_key "$plain"
    echo "backup signing key: kept ($(ssh-keygen -l -f "$plain" | awk '{print $2}'))"
  else
    ssh-keygen -q -t ed25519 -N '' -C swift-backup-signing -f "$plain" </dev/null >/dev/null ||
      die "could not generate the backup signing key"
    store_value "$BACKUP_STORE_DIR" BACKUP_SIGNING_KEY < "$plain"
    trust_signing_key "$plain"
    echo "backup signing key: created ($(ssh-keygen -l -f "$plain" | awk '{print $2}')); its public half is in $ALLOWED_SIGNERS: keep a copy of that file off this host"
  fi
  rm -f -- "${plain:?}" "${plain:?}.pub"
}

cmd_backup_set_keys() {
  [ $# -eq 0 ] || usage
  require_root "backup set-keys"
  [ ! -t 0 ] || die "the key pair is read from stdin (two lines: access key id, then secret), never typed here; use deploy/owner/swift-backup-key.command"
  local id="" secret="" api=""
  umask 077
  IFS= read -r id || true
  IFS= read -r secret || true
  id="${id%$'\r'}"
  secret="${secret%$'\r'}"
  [ -n "$id" ] && [ -n "$secret" ] || die "two non-empty lines are needed on stdin (access key id, then secret); nothing stored"
  [[ "$id" =~ ^[A-Za-z0-9]{8,128}$ ]] || { secret=""; die "the access key id has an unexpected shape; nothing stored"; }
  # The point is a key the API does not hold: refuse the API's own.
  if [ -e "$STORE_DIR/AWS_ACCESS_KEY_ID.cred" ]; then
    api="$(systemd-creds decrypt --name=AWS_ACCESS_KEY_ID "$STORE_DIR/AWS_ACCESS_KEY_ID.cred" - 2>/dev/null || true)"
    if [ -n "$api" ] && [ "$api" = "$id" ]; then
      secret=""; api=""
      die "that is the API's own storage key (AWS_ACCESS_KEY_ID): create a NEW key limited to the backup bucket; nothing stored"
    fi
  fi
  api=""
  install -d -m 0700 "$BACKUP_STORE_DIR"
  printf '%s' "$id" | store_value "$BACKUP_STORE_DIR" BACKUP_AWS_ACCESS_KEY_ID
  printf '%s' "$secret" | store_value "$BACKUP_STORE_DIR" BACKUP_AWS_SECRET_ACCESS_KEY
  secret=""
  printf '%s' dedicated | store_value "$BACKUP_STORE_DIR" BACKUP_KEY_SOURCE
  echo "stored the backup storage key pair (BACKUP_KEY_SOURCE=dedicated)"
}

cmd_backup_list() {
  [ $# -eq 0 ] || usage
  require_root "backup list"
  local name
  for name in $BACKUP_NAMES; do
    if [ -e "$BACKUP_STORE_DIR/$name.cred" ]; then echo "$name"; fi
  done
  echo "storage key: $(backup_source)"
}

cmd_backup() {
  case "${1:-}" in
    init) shift; cmd_backup_init "$@" ;;
    set-keys) shift; cmd_backup_set_keys "$@" ;;
    list) shift; cmd_backup_list "$@" ;;
    *) usage ;;
  esac
}

case "${1:-}" in
  set) shift; cmd_set "$@" ;;
  list) shift; cmd_list "$@" ;;
  materialize) shift; cmd_materialize "$@" ;;
  backup) shift; cmd_backup "$@" ;;
  *) usage ;;
esac
