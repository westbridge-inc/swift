# Never commit a filled-in deploy env — it holds live secrets.
.env
.env.*
!.env.deploy.example
# Store submission key (Play Console service account).
google-play-service-account.json

# Database dumps written by backup.sh. A committed dump is every user's row in
# a PUBLIC repo — names, phone numbers, addresses, order history.
backups/
*.dump
*.dump.partial
