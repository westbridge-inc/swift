# Swift admin (Mission Control web console, Next.js). Copy to `.env.local`.
# NEXT_PUBLIC_ vars are inlined into the client bundle — publishable only.
# The console talks ONLY to the admin API over HTTP(S) — never a DB directly.

# Admin API origin the browser calls. Dev default: http://localhost:3000.
# Set to your deployed API (e.g. https://api.swift.gy) for staging/prod, and
# make sure that origin is in the API's CORS_ORIGIN allow-list.
NEXT_PUBLIC_API_URL=http://localhost:3000
