# ──────────────────────────────────────────────────────────────────────────
# Swift API — environment. Copy to `.env` and fill in. No real secrets here.
# Every external service sits behind a swappable provider and DEFAULTS to a
# dev/local adapter, so the only value you must set to boot is JWT_SECRET.
# ──────────────────────────────────────────────────────────────────────────

# ── Core (required) ──
DATABASE_URL=postgresql://swift:swift@localhost:5434/swift   # PostGIS — see infrastructure/docker/docker-compose.yml
REDIS_URL=redis://localhost:6382
JWT_SECRET=change-me-to-64-random-chars                      # server REFUSES to boot without this
# (No JWT_REFRESH_SECRET: refresh tokens are opaque random ids stored + revoked
# in the DB, not signed JWTs.)
NODE_ENV=development                                         # development | production

# ── Server ──
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false                                           # false | true | <hop count> — true when behind a load balancer
RUN_WORKERS=                                               # unset/1 = this API process runs the BullMQ workers (single-process
                                                           # default). 0 = enqueue-only; run `node dist/worker.js` as the
                                                           # dedicated worker so N API instances don't process jobs N times.
CORS_ORIGIN=http://localhost:3001                          # comma-separated allow-list; REQUIRED in prod (no wildcard fallback)
SOCKET_REDIS_STARTUP_TIMEOUT_MS=10000                     # one fail-closed deadline for Socket.IO Redis duplicate connect + subscription readiness
SOCKET_SHUTDOWN_TIMEOUT_MS=5000                           # bounded Socket.IO/adapter close during drain
SOCKET_AUTH_RECHECK_MS=5000                               # DB fallback poll cadence when a Redis revocation publication is missed
SOCKET_AUTH_RECHECK_TIMEOUT_MS=4000                       # one node-wide authority-pass deadline; DB cancellation + failure closes the snapshot

# ── Search (Meilisearch) ──
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=                                           # blank in dev; set a master key in prod

# ── Provider selection (each defaults to a dev/local adapter) ──
NOTIFICATION_PROVIDER=dev        # dev (console) | twilio          → SMS / OTP delivery
PUSH_PROVIDER=dev                # dev (log) | expo → device push. Expo needs NO server key
                                 # (APNs/FCM creds attach to the EAS build, not the API)
MAPS_PROVIDER=osrm               # osrm (self-host, free) | google | haversine → driving ETAs
                                 # [C2/S3] osrm is the STANDARD: every fare, ETA and dispatch ranking
                                 # inherits this. haversine (straight line × a constant) is the
                                 # keyless dev fallback only — in Georgetown (canals, the Demerara,
                                 # one-ways) it mis-states all three at once. The local OSRM container
                                 # ships in ~/swift-infra/docker-compose.osrm.yml (port 5001). Watch
                                 # osrmOutcomeCounter: a high fallback rate = silently straight lines.
PLACES_PROVIDER=local            # local (saved addrs + zones, no key) | google | osm → "Where to?" search
STORAGE_PROVIDER=local           # local (disk) | s3 | r2           → document storage. Prod refuses 'local'
                                 # unless STORAGE_ALLOW_LOCAL=1 (deliberate single-instance pilot w/ volume)
PAYMENT_PROVIDER=sandbox         # sandbox | powertranz | stripe    → weekly SUBSCRIPTION billing only (never order money)
LIFECYCLE_V2=1                   # 1 = orders are born HELD (hidden from the vendor, undispatched) until the
                                 # customer's free-cancel window closes — spec Part A.
                                 # WAS 0 HERE WHILE deploy/.env.deploy.example SHIPS 1 under "match the
                                 # current launch posture". So a fresh checkout ran DIFFERENT order
                                 # semantics from production: the hold never opened, and the hold screen
                                 # — the one the whole tracking design is built around — was unreachable
                                 # while developing against it. Local now mirrors what launches.
                                 # Tests are unaffected: order-hold.test.ts and security-gaps.test.ts
                                 # each set this flag themselves rather than inheriting it.
ORDER_HOLD_MINUTES=5             # hold window length when LIFECYCLE_V2=1 (express orders always skip the hold)
                                 # [B1/S4] FIVE minutes — settled by the Swift Total Audit build order
                                 # (2026-08-25): "The hold becomes five minutes and on by default."
                                 # The hold is the product's signature window: changing your mind is
                                 # free because the store has not been told yet. Two minutes was a
                                 # different promise, and it closed the customer's free window while
                                 # the vendor's own 5:00 accept clock was still running — the exact
                                 # state the design says must never exist.
VENDOR_RESPONSE_SLA_MINUTES=10   # after the hold window, a PENDING order the vendor never accepts is
                                 # auto-cancelled (customer notified, no charge, restocked). [SWIFT-021]
CONSENT_REQUIRED=0               # 1 = registration REQUIRES acceptTerms (consent recorded w/ legal version,
                                 # SWIFT-AUD-D9-03). Leave 0 until all shipped clients send the field.
DISPATCH_AVAILABILITY=0          # 1 = honest supply gate: when zero movers are online near the pickup, the
                                 # customer is TOLD upfront — taxi shows "No drivers available · Notify me",
                                 # delivery checkout returns DELIVERY_NO_RIDERS ("order for pickup instead").
                                 # 0 = the request goes through and searches/exhausts silently (current default).
DELIVERY_BLOCK_ON_NONE=1         # (with DISPATCH_AVAILABILITY=1) 0 = never block a delivery checkout on no-riders
TAXI_ALLOW_REQUEST_ON_NONE=1     # (with DISPATCH_AVAILABILITY=1) 1 = still allow "try anyway"; 0 = hard-block on none
DISPATCH_EXHAUST_CAP=3           # exhaustion cycles before dispatch gives up for good; attempts 1..CAP-1 re-sweep,
                                 # the CAP-th is terminal (admins paged once). Lower it if orders park too early.
DISPATCH_EXHAUST_TERMINAL_TTL=21600  # seconds an exhausted order's marker persists so the reconciler won't re-cascade
                                 # + re-page hourly (default 6h; min 1h). [SWIFT-065]
AGENT_ENABLED=                    # blank = ON when ANTHROPIC_API_KEY is set (ops agent auto-manages stuck orders, spec Part B). Set 0 to disable.
                                 # Detection is deterministic; the model only classifies a PII-free snapshot.
AGENT_MODE=assist                # suggest (log only) | assist (safe actions run, money waits for a human) | auto
AGENT_MODEL_OPS=                 # override the ops-scan model (defaults to the current Haiku id in code)
AGENT_SCAN_INTERVAL_SECONDS=60   # problem-scan cadence
AGENT_MAX_ORDERS_PER_RUN=25      # cap per scan
AGENT_LLM_TIMEOUT_MS=20000       # per-model-call timeout; on timeout the order is left untouched
MMG_DRIVER=sandbox               # sandbox | live  → MMG Merchant-Initiated payments (mmg.gy/developer). Never holds marketplace money
MMG_API_URL=                     # live driver base URL; defaults to the published UAT server (mwallet.mmgtest.net/olive/publisher/v1)
MMG_MERCHANT_ID=                 # required when MMG_DRIVER=live — the collection account's merchant MSISDN (auth username + x-wss-mid)
MMG_API_KEY=                     # required when MMG_DRIVER=live — x-api-key + auth api_key   (server-only, encrypt at rest)
MMG_PASSWORD=                    # required when MMG_DRIVER=live — the merchant login password
MMG_MKEY=                        # required when MMG_DRIVER=live — MMG-issued x-wss-mkey
MMG_MSECRET=                     # required when MMG_DRIVER=live — MMG-issued x-wss-msecret
MMG_PAY_URL_ALLOWED_HOSTS=       # exact comma-separated public hostnames for vendor/driver direct-pay links; blank = cash-only (fail closed). Set only after MMG confirms the authoritative host(s)
KYC_PROVIDER=sandbox             # didit (our provider) | sandbox (manual, no key) | idanalyzer → identity checks
DISPATCH_PLANNER=greedy          # greedy | vroom (VROOM_URL required) → batch planner LIBRARY only. Not wired to
                                 # any live path (the force-assign sweep was removed in SWIFT-023; offer-cascade in
                                 # dispatch.service is production). Kept for a future deliberate batch integration.
DIDIT_API_KEY=                   # required when KYC_PROVIDER=didit (didit.me)
DIDIT_API_URL=https://verification.didit.me
ID_ANALYZER_API_KEY=             # required when KYC_PROVIDER=idanalyzer
ID_ANALYZER_API_URL=             # optional override (defaults to ID Analyzer's API)

# ── SMS / OTP  (NOTIFICATION_PROVIDER=twilio) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                                               # sending number, e.g. +15551234567
# Cost guardrails — hard daily ceilings on OTP SMS so an abuse spike can't run
# up the bill (the per-minute limit only stops bursts). Tune to your volume.
OTP_PHONE_DAILY_CAP=8                                      # max OTP SMS per phone / day
OTP_GLOBAL_DAILY_CAP=5000                                  # global circuit breaker: max OTP SMS / day
# ALSO set a Twilio account SPENDING LIMIT + geo-permissions (restrict to your
# market dial code, e.g. +592) — the definitive total-spend ceiling for ALL SMS.

# ── Maps / routing engines  (MAPS_PROVIDER=google | osrm, DISPATCH_PLANNER=vroom, PLACES_PROVIDER=osm) ──
GOOGLE_MAPS_API_KEY_BACKEND=                               # required when MAPS_PROVIDER=google
OSRM_URL=http://localhost:5001                             # required when MAPS_PROVIDER=osrm — the local container from
                                                           # ~/swift-infra/docker-compose.osrm.yml maps 5001→5000
VROOM_URL=                                                 # e.g. http://localhost:3200 — required when DISPATCH_PLANNER=vroom
PHOTON_URL=                                                # e.g. http://localhost:2322 — required when PLACES_PROVIDER=osm
NOMINATIM_URL=                                             # optional reverse-geocode fallback for PLACES_PROVIDER=osm

# ── Document storage  (STORAGE_PROVIDER=local | s3 | r2) ──
# Documents are private + encrypted; access is always via short-lived signed URLs (DPA §3.5).
# MASTER_KEK wraps the per-document AES-256 data keys (envelope encryption, onboarding spec §5).
# REQUIRED to store/read verification documents. Generate: `openssl rand -base64 32`.
MASTER_KEK=                                               # base64 32-byte key; keep it OUT of source, rotate via re-wrap
UPLOAD_DIR=                                                # local provider dir (default: <apps/api>/uploads)
API_PUBLIC_URL=                                           # origin used to build/sign local file URLs
STORAGE_SIGNING_SECRET=dev-signing-secret                 # signs local file URLs
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=                                          # set for Cloudflare R2 / S3-compatible (enables path-style)
AWS_S3_SSE=AES256                                         # server-side encryption algorithm

# ── Subscription billing  (PAYMENT_PROVIDER=powertranz | stripe) ──
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
POWERTRANZ_API_URL=https://staging.ptranz.com
STRIPE_SECRET_KEY=                                        # required when PAYMENT_PROVIDER=stripe
STRIPE_API_URL=                                           # optional override (defaults to https://api.stripe.com)

# ── Customer-facing links ──
APP_PUBLIC_URL=https://swift.gy                           # base for vendor QR / share links

# ── AI language layer (OPTIONAL — the app is fully functional without it) ──
# Language tasks only; NEVER on money/auth/dispatch paths (hard rules 1 + 3).
ANTHROPIC_API_KEY=

# ── Observability & scale ──
# /metrics is OFF unless METRICS_TOKEN is set (a bare public API must not expose
# metrics): unset ⇒ 404; set ⇒ Bearer-gated Prometheus text. Exposes
# swift_http_request_duration_seconds, swift_supply_online{pool},
# swift_scheduler_heartbeat_age_seconds, swift_db_pool{state=open|busy|idle|waiting},
# and swift_osrm_calls_total{op,outcome} (fallback rate = "is OSRM up?").
METRICS_TOKEN=                                            # random secret; gates GET /metrics. Unset in dev.
SENTRY_DSN=                                               # error tracking; unset ⇒ Sentry disabled (no-op)
RATE_LIMIT_MAX=200                                        # global ceiling / minute, per session-token (auth) or IP (anon)
# Ops paging thresholds (SWIFT-AUD-D7-02) — admins get an in-app+push page,
# dedup'd per condition, when these trip. All have sane defaults; tune later.
BILLING_FAILURE_ALERT_THRESHOLD=3                         # failed+errored+suspended subs per cycle that pages
SCHEDULER_STALL_ALERT_MINUTES=5                           # heartbeat age that pages (checked on /health polls)
POOL_WAIT_ALERT_THRESHOLD=5                               # queries waiting for a DB connection that pages
DLQ_ALERT_THRESHOLD=1                                     # dead-lettered jobs (retries exhausted) that pages. 1 by
                                                          # default: process-billing, process-settlements and
                                                          # poll-mmg-billing are in that set, so one dead job is a
                                                          # week that may not get billed. The page is deduplicated to
                                                          # one per 30 min, so a low threshold is not noisy. Act on it
                                                          # in the admin console → Platform → Background jobs.
ERROR_RATE_ALERT_PER_MIN=30                               # unhandled 500s per minute that pages
OSRM_FALLBACK_ALERT_PCT=25                                # % of routing calls degrading to straight-line, per heartbeat
                                                          # window, that pages. When OSRM is unreachable the provider
                                                          # silently falls back to haversine and fares, ETAs AND dispatch
                                                          # ranking all go wrong together. Measured 2026-08-28: Stabroek
                                                          # → Vreed-en-Hoop is 19.07 km by road (Demerara Harbour Bridge)
                                                          # and 6.72 km straight-line — a third of the ride, unpaid.
OSRM_FALLBACK_ALERT_MIN_CALLS=20                          # minimum routing calls in the window before that % means
                                                          # anything (1 fallback of 1 call is 100% and pages nobody usefully)
# ── Connection pool [P1] ──
# Prisma sizes its pool from DATABASE_URL and defaults to (num_cpus*2)+1 — five
# connections on a 2-vCPU box. The worker declares 19 concurrent BullMQ jobs, so
# that default starved it: most of the queue waited on pool_timeout the moment it
# got busy. Both processes now size their pool explicitly at the client-construction
# seam (src/utils/db-pool.ts), so a host that supplies its own DATABASE_URL still
# gets a sized pool. These two vars override the defaults; an explicit
# `connection_limit` written into DATABASE_URL itself always wins over both.
# Size to your PgBouncer / Postgres max_connections budget, NOT unbounded — every
# API replica takes its own pool.
DB_POOL_SIZE_COMBINED=40                                  # the DEFAULT topology: RUN_WORKERS unset means ONE process
                                                          # serves HTTP *and* runs all 19 job consumers off one client,
                                                          # so it needs both budgets (15 + 25), not a compromise.
DB_POOL_SIZE_API=15                                       # HTTP-only process (RUN_WORKERS=0)
DB_POOL_SIZE_WORKER=25                                    # ≥ declared job concurrency (19) + headroom (default 25)
DB_POOL_TIMEOUT_SECONDS=10                                # seconds a query waits for a free connection; 0 = wait forever
# Under load, watch swift_db_pool{state="waiting"} — if it climbs above 0, queries
# are queuing for a free connection and POOL_WAIT_ALERT_THRESHOLD above will page.

# ── Timeouts, SLAs & flow tunables (all have safe defaults; tune to volume) ──
REQUEST_TIMEOUT_MS=30000                                  # per-request hard timeout (ms)
REFRESH_REUSE_GRACE_MS=10000                              # refresh-token reuse grace (ms) for clock skew/retries before theft-revoke
REVIEW_SLA_HOURS=24                                       # onboarding doc-review SLA (hours) before it pages
DELIVERY_ESCALATE_AFTER_MIN=5                             # unclaimed-delivery age (min) before dispatch escalates
TAXI_DEMAND_WINDOW_MIN=15                                 # taxi demand-heatmap aggregation window (min)
EARNINGS_RECONCILE_GRACE_MIN=10                           # minutes after delivery before the earnings reconciler may heal a missing fee/tip row
EARNINGS_RECONCILE_DRY_RUN=0                              # 1 = the reconciler reports missing earnings rows (log + swift_earnings_missing_tuples) and writes nothing — the M-10 rollback switch
BILLING_TOPUP_HOLD=0                                      # 1 = refuse every admin top-up (503 TOPUP_ON_HOLD, nothing recorded) — the M-08 rollback; there is no unkeyed mode
CARD_RAIL_KILL=0                                          # 1 = stop issuing NEW card charge instructions; the reconciler that settles what the processor already did keeps running — the M-01 kill switch
FX_RATE_ACTIVATION_KILL=0                                 # 1 = refuse new FX rates (503); the rate in force keeps billing — the M-14 kill switch while notice delivery lags
SETTLEMENT_PUBLISH_KILL=0                                 # 1 = settlement files are staged and validated but no row publishes money until released — the M-20 publication hold
FARE_ZONE_TABLE_KILL=0                                    # 1 = the zone-to-zone fare table is ignored and every ride prices by the country formula — the M-34 rollback ("default zone only": the formula is the default)
AD_REFUND_EXECUTION_KILL=0                                # 1 = staged ad-refund intents are NOT executed (bookings, inventory, credit balance, invoice untouched) — intents keep accumulating; the R045-ADS rollback
AD_CHECKOUT_KILL=0                                        # 1 = ad checkout answers 503 (unavailable rather than ambiguous) — the R045-ADS-04 rollback
AD_PAYMENT_CONFIRM_MANUAL_ONLY=0                          # 1 = automatic (webhook) payment confirmation is refused; an operator confirms by hand — the R045-ADS-05 rollback
SOS_ESCALATION_WORKER_KILL=0                              # 1 = the tick's SOS escalation worker (drain, backfill) is paused; new triggers still stage rows and deliver inline (the fail-safe path) — the S-01 rollback
GUARDIAN_DRIVER_DEESCALATION_KILL=0                       # 1 = a driver confirmation never de-escalates an unanswered hard check (the auto-SOS proceeds) — the S-04 rollback
# [S-05] Every safety sweep walks its population in keyset pages from a persisted cursor (never a fixed take)
GUARDIAN_SWEEP_PAGE_SIZE=200                              # rides visited per Guardian tick when opening sessions
GUARDIAN_RECONCILE_PAGE_SIZE=500                          # open sessions visited per Guardian tick
EVIDENCE_LIVE_FIX_PAGE_SIZE=100                           # open SOS alerts visited per live-trail tick
INCIDENT_SLA_PAGE_SIZE=200                                # breaching cases reported per SLA tick
SWEEP_MAX_PASS_SECONDS=900                                # a sweep whose pass runs longer than this pages ops (maximum due age SLO)
SWEEP_MAX_PAGES_PER_TICK=10                               # pages a sweep may drain per tick (the SLA watch uses 25); the cursor persists between pages
GUARDIAN_CHECKIN_DELIVERY_KILL=0                          # 1 = the tick's check-in delivery worker is paused and an undelivered hard prompt HOLDS its deadline and pages ops (never auto-SOS on silence) — the S-06 rollback; asks still deliver inline
INCIDENT_INTAKE_REVIEW_ONLY=0                             # 1 = intake to the review queue: cases are created, no interim suspension or pattern escalation is derived until a human reviews — the S-08 rollback
LEGAL_HOLD_DELETION_FREEZE=0                              # 1 = evidence retention deletes nothing at all (holds stay whole, nothing is released) — the S-09 rollback
NOT_MY_DRIVER_AUTHORITY_KILL=0                            # 1 = a not-my-driver report opens the durable case and pages ops but does NOT release the ride, lock the driver or dispatch — the S-13 rollback (manual handling)
TRIP_SHARE_PUBLIC_LOOKUP_KILL=0                           # 1 = the public trip-share read is disabled outright (plaintext is never restored) — the S-16 rollback
TRIP_SHARE_VIEWS_PER_MINUTE=60                            # public reads allowed per token and per caller per minute
TRIP_SHARE_ENUMERATION_MISSES_PER_MINUTE=20               # invalid lookups per caller per minute before the caller is blocked for 10 minutes
# [S-19] An ops page is a durable obligation with per-recipient acknowledgement; unacknowledged, it escalates
OPS_ALERT_ACK_DEADLINE_SECONDS=120                        # a human must acknowledge an SOS page within this window
OPS_ALERT_ESCALATION_REPEAT_SECONDS=300                   # an unacknowledged alert is re-escalated every this many seconds
OPS_ONCALL_PHONES=                                        # comma-separated E.164 on-call numbers texted on every escalation
OPS_ALERT_DRILL_INTERVAL_DAYS=7                           # scheduled drills of the paging path (0 = off)
OPS_ALERT_ESCALATION_KILL=0                               # 1 = escalation paused; the record still says unacknowledged — never emit-equals-delivered — the S-19 rollback
BANK_RECON_READONLY=0                                     # 1 = deposit confirmations and adjustments are refused (503); reconciliation is read-only — the M-22 rollback
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send        # Expo push endpoint (PUSH_PROVIDER=expo)
HEALTH_DETAIL_TOKEN=                                      # Bearer-gates GET /health detail; unset ⇒ terse health only (cf. METRICS_TOKEN)

# ── Launch-flip flags (default OFF/safe; flip at go-live — see reports/grand/LAUNCH_FLIP) ──
# Runtime posture switches; keep OFF for a safe boot and flip deliberately at launch
# (they pair with the other flags in this file: LIFECYCLE_V2, DISPATCH_AVAILABILITY, etc.).
DISPATCH_EXHAUSTION=0                                     # terminal exhaustion state when dispatch can't fill an order
ALERTS_LOUD=0                                             # loud ops paging (push+in-app) vs quiet log-only
PREVIEW_MODE=0                                            # read-only preview posture

# ── Dev only ──
# Master OTP "000000" — opt-in AND non-production only (inert in prod/CI). Leave UNSET in prod.
DEV_OTP_BYPASS=0
