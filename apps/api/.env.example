# Swift API environment — copy to .env and fill in. No real secrets here.

# Core (required — the server refuses to start without JWT_SECRET)
DATABASE_URL=postgresql://swift:swift@localhost:5434/swift
REDIS_URL=redis://localhost:6382
JWT_SECRET=change-me-64-random-chars
JWT_REFRESH_SECRET=change-me-64-random-chars
PORT=3000
NODE_ENV=development

# CORS — comma-separated origins; REQUIRED in production (no wildcard fallback)
CORS_ORIGIN=http://localhost:3001

# Maps — used when MAPS_PROVIDER=google (Distance Matrix driving ETAs)
GOOGLE_MAPS_API_KEY_BACKEND=

# Push notifications (Firebase)
FIREBASE_PROJECT_ID=
FIREBASE_SERVER_KEY=

# SMS / OTP delivery
SMS_PROVIDER=twilio
SMS_API_KEY=
SMS_SENDER_ID=Swift

# File storage — local (dev) | s3 | r2. Documents are private + encrypted;
# access is always via short-lived signed URLs (DPA §3.5).
STORAGE_PROVIDER=local
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Set for Cloudflare R2 / S3-compatible endpoints (enables path-style)
AWS_S3_ENDPOINT=
# Dev-only: signs LocalStorageProvider URLs; API base used to build them
STORAGE_SIGNING_SECRET=dev-signing-secret
API_PUBLIC_URL=

# Subscription billing rail (PowerTranz/FAC) — used when PAYMENT_PROVIDER=powertranz.
# Charges Swift's OWN weekly subscription fee only; order money is never processed
# (cash-only, hard rule 2). Card capture is via PowerTranz's hosted SPI flow.
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
POWERTRANZ_API_URL=https://staging.ptranz.com

# AI language layer (Step 12) — OPTIONAL: the app is fully functional without
# it. Language tasks only; never on money/auth/dispatch paths (hard rule 1+3).
ANTHROPIC_API_KEY=

# Provider selection (all default to local/dev adapters)
KYC_PROVIDER=sandbox
PAYMENT_PROVIDER=sandbox # sandbox (default) | powertranz (needs PAYMENT_GATEWAY_KEY/SECRET)
STORAGE_PROVIDER=local
MAPS_PROVIDER=haversine # haversine (default, no key) | google (needs GOOGLE_MAPS_API_KEY_BACKEND)
NOTIFICATION_PROVIDER=dev

# Business config — slated for CountryConfig in Step 2; markup is removed then
MARKUP_PERCENTAGE=5
