{
  "name": "@swift/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma db push --skip-generate && tsx watch src/server.ts",
    "dev:nosync": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "worker": "tsx watch src/worker.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.0",
    "@prisma/client": "^7.9.1",
    "@sentry/node": "^10.69.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@swift/types": "workspace:*",
    "@swift/ui": "workspace:^",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.0.5",
    "dayjs": "^1.11.21",
    "exceljs": "^4.4.0",
    "fastify": "^5.11.0",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^6.0.0",
    "jsqr": "^1.4.0",
    "meilisearch": "^0.60.0",
    "nanoid": "^6.0.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "pngjs": "^7.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "prisma": "^7.9.1",
    "socket.io-client": "^4.8.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vite": "8.2.0",
    "vitest": "^4.1.0"
  }
}
