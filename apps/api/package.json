{
  "name": "@swift/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma db push --skip-generate && tsx watch src/server.ts",
    "dev:nosync": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "worker": "tsx watch src/worker.ts",
    "dpa:readiness": "tsx scripts/dpa-readiness.ts",
    "type-check": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'scripts/**/*.ts'",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1069.0",
    "@aws-sdk/s3-request-presigner": "^3.1069.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/websocket": "^11.0.0",
    "@prisma/client": "^6.4.0",
    "@sentry/node": "^10.65.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@swift/types": "workspace:*",
    "@swift/ui": "workspace:^",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.0",
    "dayjs": "^1.11.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.1",
    "fastify-plugin": "^5.0.0",
    "ioredis": "^5.4.0",
    "jsqr": "^1.4.0",
    "meilisearch": "^0.56.0",
    "nanoid": "^5.0.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "pngjs": "^7.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "4.1.0",
    "prisma": "^6.4.0",
    "socket.io-client": "^4.8.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vite": "8.0.16",
    "vitest": "^4.1.0"
  }
}
