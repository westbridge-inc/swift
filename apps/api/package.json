    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@fastify/websocket": "^11.0.0",
    "socket.io": "^4.8.0",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.0",
    "zod": "^3.24.0",
    "bcryptjs": "^2.4.3",
    "nanoid": "^5.0.0",
    "dayjs": "^1.11.0",
