// ==========================================
// OPS AGENT (spec Part B) — flag-gated OFF
// The model only CLASSIFIES; every action executes through existing
// deterministic services, and money-adjacent actions wait for a human.
// ==========================================

enum AgentActionStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

model AgentActionRequest {
  id        String            @id @default(cuid())
  /// Tool name from the fixed allowlist (request_cancel, requeue_dispatch, …)
  action    String
  /// Tool input, JSON — replayed verbatim on approval
  input     Json
  /// The model's rationale — shown to the approving human
  reasoning String?
  orderId   String?
  status    AgentActionStatus @default(PENDING)
  /// Idempotency: one open request per (action, orderId) problem
  actionKey String            @unique
  createdAt DateTime          @default(now())
  decidedAt DateTime?
  decidedBy String?

  @@index([status, createdAt])
  @@map("agent_action_requests")
}

model AgentAuditEvent {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  /// ops | approval
  job       String
  subjectId String?
  action    String
  input     Json
  /// suggested | executed | pending_approval | auto_executed | rejected | error
  outcome   String
  reasoning String?

  @@index([at])
  @@index([subjectId])
  @@map("agent_audit_events")
}

// ─── Safety: SOS engine (safety-system spec M1, foundation for M2) ───────────
// Reconciled to Swift reality: a "trip" is an Order (rides are orderType=TAXI);
// tenant is a scalar with code-level tenantScope (Swift has no RLS); actorRole
// snapshots the user's activeRole at trigger. Evidence/incident foreign keys are
// added when those milestones (M6/M7) land — additive, never up front.

enum SosStatus {
  TRIGGER_PENDING // client fired, grace window running (slide-to-cancel)
  ACTIVE // grace elapsed or user confirmed — server fan-out fired
  ACKNOWLEDGED // a human at ops has acked
  RESOLVED
  CANCELLED // cancelled during grace window only
}

enum SosTriggerSource {
  BUTTON
  CHECKIN_TIMEOUT
  GUARDIAN_ESCALATION
  OPS_MANUAL
}

enum SosCancelReason {
  SLIDE_CANCEL
  USER_MARKED_SAFE
  OPS_RESOLVED_FALSE_ALARM
}

enum SosResolutionCode {
  SAFE_CONFIRMED
  POLICE_INVOLVED
  MEDICAL
  FALSE_ALARM
  ABUSE
  UNREACHABLE_CLOSED
}

model SosAlert {
  id                   String             @id @default(cuid())
  // [F-028-04] NULLABLE ON PURPOSE. When neither the actor nor an order can
  // name a tenant, the row must say "unknown" — not silently take the
  // `swift-default` default, which is a REAL tenant with REAL admins. A
  // mislabelled emergency pages the wrong operator's admins with the
  // endangered person's location while their own admins are never told.
  // NULL routes to platform operators and the platform war room only, and
  // the RLS predicate (`tenantId = current_setting(...)`) is never true for
  // NULL, so no tenant's admins can read it either. The default stays for
  // every ordinary insert; the service writes an explicit null to override it.
  tenantId             String?            @default("swift-default")
  actorUserId          String // who triggered
  actorRole            String // activeRole snapshot: CUSTOMER / MOVER / VENDOR_OWNER
  orderId              String? // the ride/order (rides = orderType TAXI); null for a vendor store-panic
  orderType            OrderType?
  /// [B3] The service-job context — an SOS raised from a hired-professional
  /// visit (provider at the customer's home, or the provider in danger at a
  /// job). Loose reference like orderId: the alert must survive whatever
  /// happens to the job row. Exactly one of orderId / serviceJobId is set;
  /// both null = a context-free panic (store panic, standalone).
  serviceJobId         String?
  counterpartyUserId   String? // the other party on the trip at trigger time
  status               SosStatus          @default(TRIGGER_PENDING)
  triggerSource        SosTriggerSource   @default(BUTTON)
  triggeredAt          DateTime           @default(now())
  graceEndsAt          DateTime? // server-owned grace deadline → auto-ACTIVE (app-kill-proof)
  cancelledAt          DateTime?
  cancelReason         SosCancelReason?
  userSafeFlaggedAt    DateTime? // "I'm safe now" — NEVER auto-resolves; a human must (coercion doctrine)
  acknowledgedAt       DateTime?
  acknowledgedBy       String?
  resolvedAt           DateTime?
  resolvedBy           String?
  resolutionCode       SosResolutionCode?
  resolutionNotes      String?
  triggerLat           Float?
  triggerLng           Float?
  triggerAccuracyM     Float?
  triggerAddressText   String? // reverse-geocoded, for the on-screen 911 script
  clientCreatedAt      DateTime? // device clock — offline reconciliation
  clientIdempotencyKey String? // one alert per trigger PER ACTOR, even on retry — see @@unique below
  /// [F-027-17] How many times this person asked for help again while this
  /// alert was still live. Repeat triggers COLLAPSE onto the open alert rather
  /// than minting new rows, so a panicking person tapping twenty times raises
  /// one escalating incident instead of burying the ops desk in twenty.
  retriggerCount       Int                @default(0)
  lastRetriggerAt      DateTime?
  /// [F-028-03] The FACTS of each repeat trigger, appended — not just a count.
  /// A re-trigger carries a new position, source and time; recording only a
  /// counter meant ops kept seeing where the person WAS, not where they are.
  retriggers           Json?
  deliveryReceipts     Json? // per-channel fan-out receipts {opsPage, contactSms:[...], socket}
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // [F-026-17] Scoped to the ACTOR, never global. A globally unique key made
  // one person's emergency addressable by anyone who could guess or reuse the
  // string: the second caller was handed the first caller's alert and their
  // own was never raised — and a key claimed FIRST suppressed the real owner's
  // later escalation. Uniqueness that decides whether a life-safety alert
  // exists must be scoped to whose life it is.
  @@unique([actorUserId, clientIdempotencyKey])
  @@index([tenantId, status, triggeredAt])
  @@index([actorUserId])
  @@index([actorUserId, status]) // [F-027-17] the live-alert lookup on every trigger
  @@index([orderId])
  @@index([serviceJobId]) // [B3] ops lookup: every alert on this service job
}

model EmergencyContact {
  id           String    @id @default(cuid())
  tenantId     String    @default("swift-default")
  userId       String
  name         String
  phoneE164    String
  relationship String?
  priority     Int       @default(1) // 1..3 fan-out order
  verifiedAt   DateTime? // one-time SMS handshake so a typo doesn't kill the feature
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, phoneE164])
  @@index([userId])
}

/// Trip Share (safety spec §6): a tokenized PUBLIC live-trip page — browser,
/// no app needed. The token is 128-bit CSPRNG and grants ONLY the public page
/// payload, never API access. Expiry = trip end + grace (checked at read time
/// against the order's real state) under a hard mint-time ceiling. Revocable
/// by the sharer; views are counted.
model TripShareToken {
  id              String    @id @default(cuid())
  tenantId        String    @default("swift-default")
  orderId         String
  createdByUserId String
  token           String    @unique // 128-bit URL-safe random, CSPRNG
  sharedToPhone   String? // if sent by SMS from the server
  expiresAt       DateTime // hard ceiling; public read also enforces trip-end + grace
  revokedAt       DateTime?
  viewCount       Int       @default(0)
  lastViewedAt    DateTime?
  createdAt       DateTime  @default(now())
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("trip_share_tokens")
}

// ─── Trip Guardian (safety spec §5): server-side trip monitoring ────────────
// One session per monitored trip, owned entirely by the Guardian sweep (same
// runtime doctrine as the SOS grace sweep): opened when a taxi goes
// RIDE_IN_PROGRESS, detectors run off the persisted driver fixes, closed when
// the order leaves RIDE_IN_PROGRESS. Every ladder rung is DB state —
// app-kill-proof and worker-restart-proof.

enum GuardianStatus {
  MONITORING // detectors running, nothing pending from the passenger
  CHECKIN_PENDING // hard check-in sent, deadline running (§5.3 L3)
  ESCALATING // deadline elapsed — auto-SOS hand-off in progress (§5.3 L4)
  CLOSED
}

enum GuardianCloseReason {
  TRIP_COMPLETED
  TRIP_CANCELLED
  ESCALATED // handed to the SOS engine — escalatedToSosId points at the alert
  OPS_CLOSED
}

model TripSafetySession {
  id       String @id @default(cuid())
  tenantId String @default("swift-default")

  /// The monitored trip. V1 monitors TAXI rides (passenger aboard = the
  /// route-abduction threat the spec calls T3); delivery/courier legs ride on
  /// a later slice. UNIQUE so racing sweep ticks can never double-open.
  orderId         String    @unique
  orderType       OrderType
  passengerUserId String? // customer on the ride; null on a future driver-only leg
  driverUserId    String

  status GuardianStatus @default(MONITORING)

  /// §5.1 — additive risk score computed at session open; the band
  /// (LOW <30 / ELEVATED 30–59 / HIGH ≥60) sets detector thresholds and ops
  /// visibility. riskFactors snapshots WHY it scored what it did.
  riskScore   Int   @default(0)
  riskFactors Json?

  /// Server-owned trip deadline: pickedUpAt + the fare's planned duration
  /// (taxiDuration) + the overdue allowance. The overdue detector reads this.
  plannedEtaAt DateTime?

  /// Rolling detector scratch state (divergence ratchet, stop anchor/timer,
  /// ladder event log). JSON because only the sweep reads/writes it — every
  /// DECISION it produces lands in the typed columns below.
  deviationState Json?
  lastLocationAt DateTime?

  // §5.3 check-in ladder — rungs are DB state, never in-process timers.
  checkinRequestedAt DateTime?
  checkinDeadlineAt  DateTime?
  checkinRespondedAt DateTime?

  escalatedToSosId String?
  closedAt         DateTime?
  closeReason      GuardianCloseReason?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, driverUserId])
}

// ─── Identity Assurance (safety spec §7): liveness face-match checks ────────
// Answers "is the person driving the account's approved human?" at go-online
// (and later mid-shift / on a rider report). The match itself rides the SAME
// KycProvider seam the L2 flow uses; this table is the auditable outcome log
// the go-online gate and the Command review queue read.

enum LivenessPurpose {
  GO_ONLINE
  RANDOM_MID_SHIFT
  RIDER_REPORTED // "this isn't my driver"
}

enum LivenessOutcome {
  PASS
  BORDERLINE // allowed online, queued for human review (§7.1)
  FAIL
  ERROR_FAIL_OPEN // analyzer down; tenant policy let them online, flagged for retro-review
  ERROR_FAIL_CLOSED // analyzer down; tenant policy blocked go-online
}

model LivenessCheck {
  id             String          @id @default(cuid())
  tenantId       String          @default("swift-default")
  userId         String
  /// Which mover profile this shift check was for (a user can hold both).
  profile        String // 'DRIVER' | 'RIDER'
  purpose        LivenessPurpose @default(GO_ONLINE)
  selfieUrl      String
  /// Face-match confidence from the provider; null on transport errors.
  score          Float?
  outcome        LivenessOutcome
  /// BORDERLINE / fail-open / reported checks land in the Command queue.
  reviewRequired Boolean         @default(false)
  reviewedAt     DateTime?
  reviewedBy     String?
  reviewNote     String?
  createdAt      DateTime        @default(now())

  @@index([tenantId, userId, createdAt])
  @@index([tenantId, reviewRequired, reviewedAt])
}

// ─── Incident Management (safety spec §8): the case machine ─────────────────
// One auditable case per safety concern, whatever the intake surface (SOS
// resolution, in-trip report, post-trip report, rating flag, ops-logged).
// State machine OPEN → TRIAGED → INVESTIGATING → DECIDED → CLOSED, with
// ESCALATED_POLICE as a parallel flag that sets legalHold. SLA clocks are
// computed AT INTAKE from severity and live as columns — the breach queue is
// an indexed read, never a computation.

enum IncidentSeverity {
  S0 // life/violence — ack 5 min, decide 24h
  S1 // credible threat / identity dispute — ack 1h, decide 48h
  S2 // harassment / dangerous driving — ack 12h, decide 5d
  S3 // disputes, anomalies — ack 24h, decide 10d
  S4 // quality-grade — ack 24h, decide 10d
}

enum IncidentStatus {
  OPEN
  TRIAGED
  INVESTIGATING
  DECIDED
  CLOSED
}

enum IncidentIntake {
  SOS_RESOLUTION
  IN_TRIP_REPORT
  POST_TRIP_REPORT
  RATING_FLAG
  OPS_CREATED
  SYSTEM_AUTO // guardian completion flags, not-my-driver, pattern escalations
}

model IncidentCase {
  id         String           @id @default(cuid())
  tenantId   String           @default("swift-default")
  caseNumber String           @unique // human handle: INC-XXXXXXXX
  status     IncidentStatus   @default(OPEN)
  severity   IncidentSeverity
  /// Structured category code (SAFETY_ASSAULT, IDENTITY_MISMATCH, …) —
  /// severity is auto-suggested from it at intake; ops can override.
  category   String
  intake     IncidentIntake

  /// Who the case is ABOUT.
  subjectUserId  String
  /// Who reported it — §8.5 reporter protection: NEVER exposed to the
  /// subject; subject-facing notifications reference the category only.
  reporterUserId String?
  orderId        String?
  sosAlertId     String?

  summary String
  details Json?

  // §8.2 parallel police flag — sets legalHold on everything attached.
  escalatedPoliceAt DateTime?
  legalHold         Boolean   @default(false)

  // §8.2 SLA clocks — stamped at intake, never recomputed.
  slaAckBy    DateTime
  slaDecideBy DateTime

  ackedAt       DateTime?
  ackedBy       String?
  decidedAt     DateTime?
  decidedBy     String?
  /// DISMISSED | WARNING_ISSUED | SUSPENSION_PERMANENT | RESOLVED_OTHER
  decisionCode  String?
  decisionNotes String?
  closedAt      DateTime?
  closedBy      String?

  /// §8.3 interim action applied at intake: SUSPENDED_PENDING_REVIEW |
  /// SHADOW_RESTRICTED | NONE. Lifting it is an explicit, audited ops act.
  interimAction String @default("NONE")

  /// §8.4 pattern intelligence stamp — set by the on-intake hook / nightly job.
  patternFlaggedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status, severity])
  @@index([subjectUserId, createdAt])
  @@index([tenantId, slaAckBy])
}

// ─── Evidence Vault (safety spec §9): tamper-evident case evidence ──────────
// A bundle opens automatically on SOS ACTIVE and on S0/S1 case intake, and
// snapshots every artifact the platform holds AT CAPTURE TIME (content +
// SHA-256). Sealing stamps every item and computes the bundle sealHash; after
// that, mutation is blocked by the service layer AND by Postgres triggers
// (see the migration) — the DB itself refuses. Chain of custody: every
// content view/seal/export writes a SafetyAccessLog row with a required
// reason. Retention: an unsealed bundle that never grew a case is deleted
// after EVIDENCE_UNATTACHED_RETENTION_DAYS; legalHold overrides everything.

enum EvidenceItemKind {
  SOS_ALERT
  INCIDENT_CASE
  ORDER_SNAPSHOT
  STATUS_TIMELINE
  GUARDIAN_SESSION
  LIVENESS_CHECKS
  CHAT_TRANSCRIPT
  FANOUT_RECEIPTS
  LOCATION_FIX
  NOTE
}

model EvidenceBundle {
  id            String         @id @default(cuid())
  tenantId      String         @default("swift-default")
  bundleNumber  String         @unique // human handle: EV-XXXXXXXX
  sosAlertId    String?        @unique
  caseId        String?        @unique // IncidentCase
  subjectUserId String?
  openedAt      DateTime       @default(now())
  sealedAt      DateTime?
  sealedBy      String?
  /// SHA-256 over the sorted item hashes — the tamper-evidence root.
  sealHash      String?
  legalHold     Boolean        @default(false)
  items         EvidenceItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId, sealedAt])
  @@index([subjectUserId])
}

model EvidenceItem {
  id          String           @id @default(cuid())
  bundleId    String
  bundle      EvidenceBundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  kind        EvidenceItemKind
  label       String
  /// Canonical snapshot at capture — never a live pointer.
  content     Json
  /// SHA-256 of the canonical serialization, computed at capture.
  contentHash String
  /// Stamped at bundle seal — the Postgres trigger blocks any change after.
  sealedAt    DateTime?
  createdAt   DateTime         @default(now())

  @@index([bundleId])
}

model SafetyAccessLog {
  id             String   @id @default(cuid())
  tenantId       String   @default("swift-default")
  bundleId       String
  accessorUserId String
  action         String // OPEN | VIEW | SEAL | EXPORT | LEGAL_HOLD
  reason         String
  at             DateTime @default(now())

  @@index([bundleId, at])
}

// ═══════════════════════════════════════════════════════════════════════════
// SWIFT ADS — in-app advertising platform (ads-platform spec §5).
// Reconciled to the repo: id = cuid() (not the spec's uuid), tenantId defaults
// to "swift-default" like every other model, snake_case @@map, Decimal money.
// The spec asks for Postgres RLS; the repo enforces tenancy at the code layer
// via tenantScope (audit F-0002 — no RLS anywhere), so these tables follow the
// SAME code-level pattern, not RLS, for consistency. Ad money is PLATFORM
// revenue (operator sells screen space) — it reuses the subscription billing
// rails (PaymentProvider: Sandbox/PowerTranz/MMG) and never touches
// order/settlement money.
// ═══════════════════════════════════════════════════════════════════════════

enum AdvertiserStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum AdvertiserMemberRole {
  OWNER
  MANAGER
  ANALYST
}

enum AdCampaignStatus {
  DRAFT
  PENDING_PAYMENT
  PENDING_REVIEW
  SCHEDULED
  LIVE
  PAUSED
  COMPLETED
  REJECTED
  CANCELLED
}

enum AdCreativeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdTranscodeStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum AdBookingStatus {
  RESERVED
  CONFIRMED
  RELEASED
  CANCELLED
  REFUNDED
}

enum AdInvoiceStatus {
  UNPAID
  PAID
  VOID
  REFUNDED
  PARTIALLY_REFUNDED
}

enum AdMediaKind {
  IMAGE
  VIDEO
}

enum AdEventType {
  IMPRESSION
  VIEWABLE_IMPRESSION
  CLICK
  VIDEO_START
  VIDEO_Q25
  VIDEO_Q50
  VIDEO_Q75
  VIDEO_COMPLETE
}

enum AdDestinationType {
  NONE
  URL
  DEEPLINK
}

enum AdRefundReason {
  AUTO_CANCEL_UNAPPROVED
  ADVERTISER_CANCEL
  ADMIN_KILL
  LATE_APPROVAL
  PLACEMENT_DOWN
}

enum AdRefundIntentStatus {
  PENDING
  PROCESSING
  MANUAL_REQUIRED
  SUCCEEDED
  FAILED
}

enum AdRefundItemKind {
  REFUND
  CREDIT
}

enum AdRefundPayoutRail {
  PROVIDER
  MANUAL
}

model Advertiser {
  id              String             @id @default(cuid())
  tenantId        String             @default("swift-default")
  companyName     String
  legalName       String?
  registrationNo  String?
  industry        String
  website         String?
  contactName     String
  contactEmail    String
  contactPhone    String
  city            String?
  status          AdvertiserStatus   @default(PENDING_REVIEW)
  statusReason    String?
  /// The User who registered the company (first OWNER member).
  createdByUserId String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  members         AdvertiserMember[]
  campaigns       AdCampaign[]
  invoices        AdInvoice[]

  @@index([tenantId, status])
  @@map("advertisers")
}

model AdvertiserMember {
  advertiserId String
  userId       String
  role         AdvertiserMemberRole @default(OWNER)
  createdAt    DateTime             @default(now())
  advertiser   Advertiser           @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  @@id([advertiserId, userId])
  @@index([userId])
  @@map("advertiser_members")
}

model AdPlacement {
  id                   String            @id @default(cuid())
  tenantId             String            @default("swift-default")
  key                  String // home_hero_video | home_top_card | home_ad_bar
  name                 String
  tier                 Int // 1 | 2 | 3
  mediaKind            AdMediaKind
  slotsPerWeek         Int               @default(1)
  rotationSeconds      Int? // bar only
  weeklyPrice          Decimal           @db.Decimal(12, 2)
  currency             String            @default("GYD")
  freqCapPerUserPerDay Int? // viewable impressions; null = uncapped
  active               Boolean           @default(true)
  campaigns            AdCampaign[]
  inventory            AdInventoryWeek[]
  houseAds             HouseAd[]

  @@unique([tenantId, key])
  @@map("ad_placements")
}

model AdInventoryWeek {
  id          String      @id @default(cuid())
  placementId String
  city        String      @default("*") // "*" = tenant-wide when tenant has one city
  weekStart   DateTime    @db.Date // always a Monday (CHECK in migration)
  capacity    Int
  booked      Int         @default(0) // CHECK (booked BETWEEN 0 AND capacity) in migration; row-locked
  placement   AdPlacement @relation(fields: [placementId], references: [id])

  @@unique([placementId, city, weekStart])
  @@map("ad_inventory_weeks")
}

model AdCampaign {
  id               String            @id @default(cuid())
  tenantId         String            @default("swift-default")
  advertiserId     String
  placementId      String
  name             String
  objective        String? // AWARENESS | TRAFFIC | PROMOTION
  cities           String[] // subset of tenant cities; ["*"] for all
  startWeek        DateTime          @db.Date
  endWeek          DateTime          @db.Date // Monday of the LAST booked week
  destinationType  AdDestinationType @default(NONE)
  destinationValue String?
  status           AdCampaignStatus  @default(DRAFT)
  statusReason     String?
  totalAmount      Decimal?          @db.Decimal(12, 2)
  currency         String            @default("GYD")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  advertiser       Advertiser        @relation(fields: [advertiserId], references: [id])
  placement        AdPlacement       @relation(fields: [placementId], references: [id])
  creatives        AdCreative[]
  bookings         AdBooking[]
  invoices         AdInvoice[]
  refundIntents    AdRefundIntent[]

  @@unique([id, tenantId], map: "ad_campaigns_id_tenantId_key")
  @@index([tenantId, status])
  @@index([placementId, status])
  @@index([advertiserId, status])
  @@map("ad_campaigns")
}

model AdCreative {
  id               String            @id @default(cuid())
  campaignId       String
  kind             AdMediaKind
  fileUrl          String
  posterUrl        String? // required for video before review
  width            Int?
  height           Int?
  durationSeconds  Decimal?          @db.Decimal(6, 2)
  sizeBytes        BigInt?
  headline         String? // ≤60 hero / ≤40 others — enforced in service
  body             String? // ≤90
  ctaLabel         String? // ≤15
  transcodeStatus  AdTranscodeStatus @default(READY) // videos start QUEUED
  status           AdCreativeStatus  @default(PENDING)
  preScreen        Json? // §10.4 advisory-only annotations — assists review, NEVER decides
  reviewNotes      String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime          @default(now())
  campaign         AdCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("ad_creatives")
}

model AdBooking {
  id            String          @id @default(cuid())
  campaignId    String
  placementId   String
  city          String          @default("*")
  weekStart     DateTime        @db.Date
  amount        Decimal         @db.Decimal(12, 2) // price LOCKED at checkout
  status        AdBookingStatus @default(RESERVED)
  reservedUntil DateTime?
  campaign      AdCampaign      @relation(fields: [campaignId], references: [id])
  refundItems   AdRefundItem[]

  @@unique([campaignId, placementId, city, weekStart])
  @@unique([id, campaignId], map: "ad_bookings_id_campaignId_key")
  @@index([placementId, city, weekStart, status])
  @@index([status, reservedUntil])
  @@map("ad_bookings")
}

model AdInvoice {
  id             String          @id @default(cuid())
  tenantId       String          @default("swift-default")
  advertiserId   String
  campaignId     String
  number         String          @unique // ADS-{YYYY}-{seq}
  amount         Decimal         @db.Decimal(12, 2)
  currency       String          @default("GYD")
  status         AdInvoiceStatus @default(UNPAID)
  provider       String? // MMG | POWERTRANZ | MANUAL | MOCK
  providerRef    String?
  paymentUrl     String?
  paidAt         DateTime?
  refundedAmount Decimal         @default(0) @db.Decimal(12, 2)
  createdAt      DateTime        @default(now())
  advertiser     Advertiser      @relation(fields: [advertiserId], references: [id])
  campaign       AdCampaign      @relation(fields: [campaignId], references: [id])
  refundIntents  AdRefundIntent[]

  @@unique([id, tenantId, campaignId, currency], map: "ad_invoices_id_tenantId_campaignId_currency_key")
  @@index([tenantId, status])
  @@index([providerRef])
  @@map("ad_invoices")
}

/// Durable, replay-safe record of money Swift owes for one ads refund plan.
/// Policy inputs and the exact minor-unit total are immutable in PostgreSQL;
/// only payout lifecycle/proof fields may advance after creation.
model AdRefundIntent {
  id                  String               @id @default(cuid())
  tenantId            String
  invoiceId           String
  campaignId          String
  idempotencyKey      String               @unique(map: "ad_refund_intents_idempotencyKey_key")
  reason              AdRefundReason
  status              AdRefundIntentStatus @default(PENDING)
  amountMinor         BigInt
  currency            String
  payoutRail          AdRefundPayoutRail?
  provider            String?
  providerRefundRef   String?
  /// Partial unique index lives in the migration because Prisma cannot model
  /// `WHERE manualPayoutRef IS NOT NULL`.
  manualPayoutRef     String?
  correlationId       String
  requestedByUserId   String?
  failureCode         String?
  failureDetail       String?
  processingStartedAt DateTime?
  completedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice             AdInvoice            @relation(fields: [invoiceId, tenantId, campaignId, currency], references: [id, tenantId, campaignId, currency], onDelete: Restrict, map: "ad_refund_intents_invoice_tenant_campaign_currency_fkey")
  campaign            AdCampaign           @relation(fields: [campaignId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "ad_refund_intents_campaign_tenant_fkey")
  items               AdRefundItem[]
  outbox              AdRefundOutbox?

  @@unique([id, tenantId], map: "ad_refund_intents_id_tenantId_key")
  @@unique([id, tenantId, campaignId], map: "ad_refund_intents_id_tenantId_campaignId_key")
  @@index([tenantId, status, createdAt])
  @@index([invoiceId])
  @@index([campaignId, status])
  @@map("ad_refund_intents")
}

/// Immutable allocation evidence. Corrections require a new compensating
/// intent; UPDATE and DELETE are rejected by database triggers.
model AdRefundItem {
  id             String           @id @default(cuid())
  tenantId       String
  refundIntentId String
  campaignId     String
  bookingId      String
  kind           AdRefundItemKind
  amountMinor    BigInt
  createdAt      DateTime         @default(now())
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  refundIntent   AdRefundIntent   @relation(fields: [refundIntentId, tenantId, campaignId], references: [id, tenantId, campaignId], onDelete: Restrict, map: "ad_refund_items_intent_tenant_campaign_fkey")
  booking        AdBooking        @relation(fields: [bookingId, campaignId], references: [id, campaignId], onDelete: Restrict, map: "ad_refund_items_booking_campaign_fkey")

  @@unique([refundIntentId, bookingId, kind], map: "ad_refund_items_intent_booking_kind_key")
  @@index([tenantId, refundIntentId])
  @@index([bookingId])
  @@map("ad_refund_items")
}

/// Transactional payout outbox. A worker claims rows with an expiring token;
/// stale workers cannot complete another worker's lease. One row per intent,
/// globally deduped, and dead letters remain durable for reconciliation.
model AdRefundOutbox {
  id             String         @id @default(cuid())
  tenantId       String
  refundIntentId String         @unique(map: "ad_refund_outbox_refundIntentId_key")
  dedupeKey      String         @unique(map: "ad_refund_outbox_dedupeKey_key")
  eventType      String         @default("ad_refund.execute")
  eventVersion   Int            @default(1)
  payload        Json
  correlationId  String
  availableAt    DateTime       @default(now())
  leaseOwner     String?
  leaseToken     String?
  leaseExpiresAt DateTime?
  attempts       Int            @default(0)
  maxAttempts    Int            @default(12)
  lastError      String?
  processedAt    DateTime?
  deadLetteredAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  refundIntent   AdRefundIntent @relation(fields: [refundIntentId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "ad_refund_outbox_intent_tenant_fkey")

  @@unique([refundIntentId, tenantId], map: "ad_refund_outbox_refundIntentId_tenantId_key")
  @@index([tenantId, processedAt, deadLetteredAt, availableAt], map: "ad_refund_outbox_tenant_pending_idx")
  @@index([leaseExpiresAt])
  @@map("ad_refund_outbox")
}

model AdEvent {
  id           BigInt      @id @default(autoincrement())
  tenantId     String      @default("swift-default")
  campaignId   String
  creativeId   String
  placementKey String
  city         String?
  eventType    AdEventType
  userHash     String? // sha256(userId + daily salt) — NEVER a raw user id
  sessionId    String
  occurredAt   DateTime
  receivedAt   DateTime    @default(now())
  tokenHash    String
  meta         Json?

  @@index([campaignId, occurredAt])
  @@index([occurredAt])
  @@map("ad_events")
}

model AdEventDedupe {
  tokenHash String
  eventType AdEventType
  createdAt DateTime    @default(now())

  @@id([tokenHash, eventType]) // insert-or-conflict = duplicate → drop; prune >48h via cron
  @@map("ad_event_dedupe")
}

model AdFreqCounter {
  userHash     String
  placementKey String
  day          DateTime @db.Date
  count        Int      @default(0)

  @@id([userHash, placementKey, day]) // prune >7d via cron
  @@map("ad_freq_counters")
}

model AdStatsDaily {
  campaignId          String
  creativeId          String
  day                 DateTime @db.Date
  city                String   @default("*")
  impressions         Int      @default(0)
  viewableImpressions Int      @default(0)
  clicks              Int      @default(0)
  videoStarts         Int      @default(0)
  videoCompletes      Int      @default(0)
  spend               Decimal  @default(0) @db.Decimal(12, 2) // recognized daily = weekly price / 7

  @@id([campaignId, creativeId, day, city])
  @@map("ad_stats_daily")
}

model HouseAd {
  id               String            @id @default(cuid())
  tenantId         String            @default("swift-default")
  placementId      String
  kind             AdMediaKind
  fileUrl          String
  posterUrl        String?
  headline         String?
  ctaLabel         String?
  destinationType  AdDestinationType @default(NONE)
  destinationValue String?
  active           Boolean           @default(true)
  sort             Int               @default(0)
  placement        AdPlacement       @relation(fields: [placementId], references: [id])

  @@index([tenantId, placementId, active])
  @@map("house_ads")
}

model AdsSettings {
  tenantId                  String  @id @default("swift-default")
  reservationMinutes        Int     @default(20)
  reviewSlaHours            Int     @default(24) // same 24h promise as onboarding review
  cancelFullRefundDays      Int     @default(7)
  autoCancelUnapprovedHours Int     @default(24) // before startWeek
  weekTimezone              String  @default("America/Guyana")
  defaultRotationSeconds    Int     @default(6)
  platformFeePct            Decimal @default(0) @db.Decimal(5, 2) // Westbridge cut; 0 while founder = operator
  restrictedCategories      Json? // { alcohol, gambling, political } per tenant law/policy

  @@map("ads_settings")
}

model AdsAuditLog {
  id          String   @id @default(cuid())
  tenantId    String   @default("swift-default")
  actorUserId String
  action      String // ADVERTISER_APPROVE, CREATIVE_REJECT, CAMPAIGN_KILL, INVOICE_MARK_PAID, ...
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("ads_audit_log")
}

// ─── Trial Integrity & Identity Resolution (trial-integrity spec Parts 2–5) ──
// The identity graph keys trials to VERIFIED HUMANS, not accounts. Values are
// NEVER stored raw — every signal is HMAC-SHA256(normalized, IDENTITY_SALT).
// Matching is PLATFORM-WIDE across tenants (the one sanctioned cross-tenant
// system): visible only in founder god's-eye tooling, every view audited.
// SOFT signals score and flag; they NEVER merge clusters or punish alone.

enum IdentitySignalType {
  ID_DOC_NUMBER
  TIN
  BUSINESS_REG
  PLATE
  MMG_PAYER
  FACE_EMBEDDING
  PHONE
  DEVICE
  IP_SUBNET
  ADDRESS
  NAME_DOB
  EMAIL
}

enum SignalStrength {
  HARD
  STRONG
  SOFT
}

enum TrialGrantStatus {
  ACTIVE
  CONSUMED
  REVOKED
}

enum EnforcementLevel {
  NONE
  DENY_TRIAL
  REVIEW_FIRST
  BLOCK_PENDING_FOUNDER
}

enum AppealStatus {
  NONE
  OPEN
  UPHELD
  OVERTURNED
}

model IdentityKey {
  id         String             @id @default(cuid())
  type       IdentitySignalType
  valueHash  String
  accountId  String // platform user id
  tenantId   String             @default("swift-default") // where captured (audit); matching is platform-wide
  actorRole  String // VENDOR | RIDER | DRIVER | SERVICE | CUSTOMER | ADVERTISER
  source     String // AI_ID_ANALYZER | ONBOARDING_DOC | SIGNUP | BILLING | DEVICE | REQUEST_META
  capturedAt DateTime           @default(now())

  @@index([type, valueHash])
  @@index([accountId])
  @@map("identity_keys")
}

model IdentityCluster {
  id           String                  @id @default(cuid())
  createdAt    DateTime                @default(now())
  mergedIntoId String? // union history — resolvers follow to the root
  members      IdentityClusterMember[]
  trialGrants  TrialGrant[]

  @@map("identity_clusters")
}

model IdentityClusterMember {
  accountId String          @id // an account lives in exactly one cluster
  clusterId String
  linkedVia Json // [{type, strength, matchedAccountId, at, meta?}] — the explainability record
  addedAt   DateTime        @default(now())
  cluster   IdentityCluster @relation(fields: [clusterId], references: [id])

  @@index([clusterId])
  @@map("identity_cluster_members")
}

model FaceTemplate {
  accountId String   @id
  embedding Bytes // application-layer encrypted (AES-256-GCM, INTEGRITY_FACE_KEY); compared in service memory only
  modelVer  String
  createdAt DateTime @default(now())

  @@map("face_templates")
}

model TrialGrant {
  id           String           @id @default(cuid())
  tenantId     String           @default("swift-default")
  clusterId    String
  role         String // VENDOR | RIDER | DRIVER | SERVICE
  accountId    String // the member actually consuming it
  status       TrialGrantStatus @default(ACTIVE)
  startedAt    DateTime
  endsAt       DateTime
  statusReason String?
  cluster      IdentityCluster  @relation(fields: [clusterId], references: [id])

  // ★ THE LAW: one trial per human per role per tenant. The DB guards the
  // RACE via a PARTIAL unique on ACTIVE rows (raw SQL in the migration —
  // Prisma can't express partial uniques; `db push` can't see raw DDL, so
  // constraint-dependent tests self-install it). A FULL unique is wrong by
  // design: CONSUMED/REVOKED history must coexist under one cluster after a
  // retroactive union (§3.4). decide() enforces the consumed/revoked denials.
  @@index([tenantId, clusterId, role])
  @@index([accountId])
  @@map("trial_grants")
}

model EnforcementAction {
  id           String           @id @default(cuid())
  accountId    String
  clusterId    String?
  level        EnforcementLevel
  reasonCode   String // internal, precise: TRIAL_ALREADY_CONSUMED, FACE_ID_MISMATCH, PAYER_DUPLICATE, VELOCITY_DEVICE…
  signalsFired Json // the exact evidence, for the founder's eyes
  decidedBy    String // "SYSTEM" | admin userId
  appeal       AppealStatus     @default(NONE)
  appealNote   String?
  createdAt    DateTime         @default(now())

  @@index([accountId])
  @@index([level, createdAt])
  @@map("enforcement_actions")
}

model ExceptionGrant {
  id        String    @id @default(cuid())
  clusterId String
  scope     String // MULTI_LOCATION_VENDOR | HOUSEHOLD | FOUNDER_OVERRIDE
  note      String
  grantedBy String
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([clusterId])
  @@map("exception_grants")
}

model SignupAttempt {
  id         String   @id @default(cuid())
  phoneHash  String?
  deviceHash String?
  ipHash     String?
  outcome    String // CREATED | REVIEW_FIRST | HELD | REJECTED
  createdAt  DateTime @default(now())

  @@index([deviceHash, createdAt])
  @@index([ipHash, createdAt])
  @@index([phoneHash, createdAt])
  @@map("signup_attempts")
  @@index([createdAt]) // retention sweep cutoff [F-021-20]
}

model IntegritySettings {
  id                        String  @id @default("platform")
  maxSignupsPerDevice24h    Int     @default(3)
  maxOtpPerPhonePerHour     Int     @default(5)
  ipFlagThreshold24h        Int     @default(15)
  faceLinkCosine            Decimal @default(0.92) @db.Decimal(4, 3)
  faceFlagCosine            Decimal @default(0.85) @db.Decimal(4, 3)
  retroRevokeNoticeHours    Int     @default(48)
  tombstoneRetentionEnabled Boolean @default(false) // DPA founder decision — OFF until decided

  @@map("integrity_settings")
}

// ─── USD Platform Pricing (batching/USD spec System 2, Parts 10–15/20) ───────
// USD is the price; local is the settlement; the charge is immutable once
// written. One price book across every Caribbean market; the FX rate is
// founder-set, append-only, and PINNED per charge — reconciled: Swift's fee
// billing has no invoice model, so the pinned trio (USD, rate, local) lands
// on the BillingEvent charge rows. Ships dark behind usdPricing config.

model PriceBookEntry {
  id            String   @id @default(cuid())
  role          String // VENDOR | RIDER | DRIVER | SERVICE
  tier          String? // plan tier where plans exist (e.g. SMALL_VENDOR)
  amountUsd     Decimal  @db.Decimal(10, 2)
  active        Boolean  @default(true)
  effectiveFrom DateTime @default(now())

  @@index([role, active])
  @@map("price_book_entries")
}

model FxRate {
  id            String   @id @default(cuid())
  base          String   @default("USD")
  quote         String // GYD | TTD | JMD | BBD
  rate          Decimal  @db.Decimal(12, 6)
  source        String // FOUNDER_MANUAL | BOG_REFERENCE (a label, not a feed)
  setByUserId   String
  effectiveFrom DateTime
  createdAt     DateTime @default(now())

  @@index([quote, effectiveFrom])
  @@map("fx_rates")
}

model TenantBillingCurrency {
  tenantId           String    @id
  settlementCurrency String    @default("GYD")
  roundingIncrement  Decimal   @default(100) @db.Decimal(10, 2) // GYD:100 TTD:1 JMD:50 BBD:1
  displayDual        Boolean   @default(true)
  usdPricingEnabled  Boolean   @default(false) // dark until the founder enables (Mode A/B chosen then)
  usdMigrationMode   String? // A (convert) | B (grandfather) — founder-chosen at enable
  usdSunsetAt        DateTime? // Mode B: grandfathered rates clear at this instant

  @@map("tenant_billing_currency")
}

// ─── Batched Delivery Runs (batching/USD spec System 1) ──────────────────────
// One rider, 1–3 orders, sequenced stops; every order keeps its OWN state
// machine, PIN, cash line, and frozen quote. SHADOW FIRST (Part 8): the
// scanner writes SHADOW_WOULD_BATCH evidence rows for ≥2 weeks before any
// real offer fires; batching.enabled defaults OFF per tenant. RunStop is the
// source of truth for membership + sequence; solo orders get a 2-stop run
// too when live — one code path, no legacy fork.

enum RunStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum StopKind {
  PICKUP
  DROPOFF
}

enum StopStatus {
  PENDING
  ARRIVED
  COMPLETED
  SKIPPED
  FAILED
}

model DeliveryRun {
  id                 String    @id @default(cuid())
  tenantId           String    @default("swift-default")
  riderId            String
  status             RunStatus @default(PLANNED)
  vehicleType        String
  capacityPointsUsed Int       @default(0)
  cashToCollectTotal Decimal   @default(0) @db.Decimal(12, 2)
  plannedDistanceM   Int?
  plannedDurationS   Int?
  version            Int       @default(0) // the versioned-accept guard (Part 18)
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  stops              RunStop[]

  @@index([riderId, status])
  @@index([tenantId, status])
  @@map("delivery_runs")
}

model RunStop {
  id            String      @id @default(cuid())
  runId         String
  orderId       String
  kind          StopKind
  seq           Int
  status        StopStatus  @default(PENDING)
  plannedEta    DateTime?
  arrivedAt     DateTime?
  completedAt   DateTime?
  cashToCollect Decimal?    @db.Decimal(12, 2)
  changeFor     Decimal?    @db.Decimal(12, 2) // C14: "bring change for GY$5,000"
  run           DeliveryRun @relation(fields: [runId], references: [id])

  @@unique([runId, seq])
  @@index([orderId])
  @@map("run_stops")
}

model BatchEvaluation {
  id             String   @id @default(cuid())
  tenantId       String   @default("swift-default")
  orderId        String
  riderId        String?
  runId          String?
  decision       String // BATCHED_STACKED | BATCHED_ADDON | SOLO | SHADOW_WOULD_BATCH
  rulesChecked   Json // [{rule:"R7", pass:true, value:312, limit:480}, …] — founder-explainable
  scoreBreakdown Json?
  createdAt      DateTime @default(now())

  @@index([orderId])
  @@index([tenantId, createdAt])
  @@map("batch_evaluations")
}

model BatchingSettings {
  tenantId                String  @id @default("swift-default")
  enabled                 Boolean @default(false) // real offers — OFF until the shadow report earns it
  shadowMode              Boolean @default(true)
  maxOrdersPerRun         Int     @default(2) // hard ceiling 3 (enforced in code)
  addonPickupDetourMaxS   Int     @default(300)
  dropoffCorridorM        Int     @default(1500)
  crossTrackMaxM          Int     @default(800)
  detourBudgetS           Int     @default(480)
  detourBudgetPct         Int     @default(25)
  hotFoodReadyToDoorMaxS  Int     @default(1500)
  pickupWaitMaxS          Int     @default(300)
  verticalMatrix          Json? // null → code seed (FOOD+FOOD, FOOD+GROCERY, GROCERY+GROCERY, COURIER+COURIER)
  sizePoints              Json? // null → {S:1,M:2,L:3,XL:4}
  capacityPointsByVehicle Json? // null → {BICYCLE:3,MOTORBIKE:4,CAR:6}
  addonScanIntervalS      Int     @default(20)

  @@map("batching_settings")
}

// ---------------------------------------------------------------------------
// QR GROWTH ENGINE (scan-to-store) — printed QR → /s/{code} resolver → web
// storefront. QrCode supersedes the dormant Vendor.qrSlug field (never wired).
// ---------------------------------------------------------------------------

/// Storefront-bearing entity kinds. Services storefronts are Vendors
/// (VendorType.SERVICE); ServiceProvider is an individual pro with no
/// storefront, so VENDOR is the only member until a new storefront model exists.
enum QrEntityType {
  VENDOR
}

enum QrStatus {
  ACTIVE
  SUPERSEDED
  DEACTIVATED
}

enum ScanDecision {
  WEB_RENDER
  APP_OPEN_ASSUMED
  RETIRED_PAGE
  UNAVAILABLE_PAGE
  NOT_FOUND
  /// Storefront rendered with ?c= (web logs it once per session) — the funnel
  /// stage between SCAN and orders.
  STORE_VIEW
  /// Install CTA tapped on the web storefront (both platforms; logged by
  /// /attribution/intent so Android taps leave a server artifact too).
  INSTALL_TAP
}

model QrCode {
  id            String       @id @default(cuid())
  tenantId      String       @default("swift-default")
  entityType    QrEntityType
  entityId      String
  /// 10-char CSPRNG, charset 23456789BCDFGHJKMNPQRSTVWXYZ, stored uppercase.
  shortCode     String       @unique
  /// Denormalized entity slug at creation; the resolver always redirects to
  /// the entity's CURRENT slug, so this is provenance, not routing truth.
  slug          String
  version       Int          @default(1)
  status        QrStatus     @default(ACTIVE)
  styleTemplate String       @default("standard")
  createdById   String
  createdAt     DateTime     @default(now())
  /// Supersede grace anchor: the old code keeps resolving for
  /// QR_SUPERSEDE_GRACE_DAYS after this instant (printed materials die slowly).
  supersededAt  DateTime?
  deactivatedAt DateTime?
  scanEvents    ScanEvent[]

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, status])
  @@map("qr_codes")
}

// PLUS (raw SQL in the migration — Prisma can't express partial uniques):
// CREATE UNIQUE INDEX one_active_qr_per_entity
//   ON "qr_codes"("tenantId","entityType","entityId") WHERE status = 'ACTIVE';
// This is the concurrency guard for get-or-create; on P2002 re-read the winner.

/// One row per scan, PII-free by construction: hashed IP (daily rotating salt),
/// hashed UA, coarse device fields only. Raw rows older than
/// SCAN_RAW_RETENTION_DAYS roll up into ScanDailyRollup then delete (DPA).
model ScanEvent {
  id          String       @id @default(cuid())
  tenantId    String       @default("swift-default")
  /// Null for NOT_FOUND scans — there is no QrCode row to point at (the spec's
  /// required FK can't store its own NOT_FOUND decision; divergence logged).
  qrCodeId    String?
  qrCode      QrCode?      @relation(fields: [qrCodeId], references: [id])
  occurredAt  DateTime     @default(now())
  decision    ScanDecision
  src         String?
  template    String?
  osFamily    String? // ios | android | desktop | other (coarse, from UA)
  deviceClass String? // phone | tablet | desktop
  uaHash      String? // sha256(UA) — never the raw UA string
  ipHash      String? // sha256(ip + daily rotating salt) — unlinkable across days
  country     String?
  sessionId   String?

  @@index([tenantId, qrCodeId, occurredAt])
  @@index([occurredAt])
  @@map("scan_events")
}

/// Printed QR codes are immortal: a rename mints a NEW slug and writes the old
/// one here. Storefront resolution: exact slug → SlugRedirect → 301 → else 404.
model SlugRedirect {
  id         String       @id @default(cuid())
  tenantId   String       @default("swift-default")
  entityType QrEntityType
  oldSlug    String
  entityId   String
  createdAt  DateTime     @default(now())

  @@unique([tenantId, entityType, oldSlug])
  @@map("slug_redirects")
}

/// iOS install-attribution candidates (Android uses the Play Install Referrer
/// instead — deterministic, no table). fpHash is computed SERVER-side from the
/// request (client supplies no fingerprint parts) and rows are ephemeral by
/// design: hard-purged hourly once expired (DPA). The single-candidate law:
/// a claim matches exactly ONE unexpired row or the app opens Home — a wrong
/// store is worse than no deep link.
model PendingAttribution {
  id               String    @id @default(cuid())
  tenantId         String    @default("swift-default")
  qrCodeId         String
  /// e.g. /store/{slug} — the ONLY thing the app ever receives on claim.
  destinationPath  String
  platform         String // ios (android never writes here)
  fpHash           String // sha256(normalizedIp | uaMajorFamily | ATTRIB_SALT)
  createdAt        DateTime  @default(now())
  expiresAt        DateTime // createdAt + ATTRIB_TTL_MINUTES
  claimedAt        DateTime?
  claimedInstallId String?

  @@index([fpHash, expiresAt])
  @@index([expiresAt])
  @@map("pending_attributions")
}

/// Claim receipts: one per installId, forever. Makes /attribution/claim
/// idempotent even after the pending row is purged, and records the funnel
/// outcome (deterministic | matched | ambiguous | none) for reconciliation.
model AttributionClaim {
  id              String   @id @default(cuid())
  tenantId        String   @default("swift-default")
  installId       String   @unique
  platform        String
  qrCodeId        String?
  destinationPath String? // null = Home
  outcome         String // deterministic | matched | ambiguous | none
  createdAt       DateTime @default(now())

  @@map("attribution_claims")
}

// ---------------------------------------------------------------------------
// CATEGORY DISCOVERY (#17, FIND-BY-CRAVING) — the platform taxonomy layer.
// NOT the per-vendor menu sections (model Category = in-store navigation,
// untouched by law B): these are curated, tenant-scoped discovery categories
// vendors PICK from (never free-text), an auto-categorizer suggests, and the
// Home rail renders. Flag-gated: PlatformConfig CATEGORY_DISCOVERY_ENABLED.
// ---------------------------------------------------------------------------

enum DiscoveryCategoryKind {
  CUISINE
  DISH
  DIETARY
  AISLE
  RETAIL
}

enum DiscoveryCategoryStatus {
  ACTIVE
  HIDDEN
  MERGED
  PENDING
}

enum DiscoveryCategoryVertical {
  FOOD
  GROCERY
  RETAIL
}

enum DiscoveryTagSource {
  VENDOR
  AUTO
  ADMIN
  DERIVED
}

model DiscoveryCategory {
  id           String                    @id @default(cuid())
  tenantId     String                    @default("swift-default")
  /// Immutable once created; kebab-case. MERGED slugs redirect via mergedIntoId.
  slug         String
  name         String
  kind         DiscoveryCategoryKind
  vertical     DiscoveryCategoryVertical
  emoji        String
  iconKey      String?
  /// Matcher dictionary — lowercased words/phrases (the Guyanese-terms moat).
  aliases      String[]
  sortWeight   Int                       @default(100)
  status       DiscoveryCategoryStatus   @default(ACTIVE)
  isSeed       Boolean                   @default(false)
  mergedIntoId String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, status, vertical, sortWeight])
  @@map("discovery_categories")
}

model VendorDiscoveryCategory {
  id         String             @id @default(cuid())
  tenantId   String             @default("swift-default")
  vendorId   String
  categoryId String
  role       String // "PRIMARY" | "SECONDARY"
  /// VENDOR/ADMIN = chosen (untouchable by machines); DERIVED = machine-managed
  /// by the Stage-C reconcile, which writes ONLY where source='DERIVED'.
  source     DiscoveryTagSource
  createdAt  DateTime           @default(now())

  @@unique([vendorId, categoryId])
  @@index([tenantId, categoryId])
  @@map("vendor_discovery_categories")
}

// Raw SQL in the migration (Prisma can't express partial uniques):
// CREATE UNIQUE INDEX one_primary_discovery_category_per_vendor
//   ON "vendor_discovery_categories"("vendorId") WHERE role = 'PRIMARY';

model ItemDiscoveryCategory {
  id         String             @id @default(cuid())
  tenantId   String             @default("swift-default")
  itemId     String
  categoryId String
  source     DiscoveryTagSource
  confidence Decimal?           @db.Decimal(3, 2)
  createdAt  DateTime           @default(now())

  @@unique([itemId, categoryId])
  @@index([tenantId, categoryId])
  @@map("item_discovery_categories")
}

// Service-enforced: max CAT_MAX_ITEM_TAGS (3) rows per item.

/// ACCEPTED/DISMISSED rows are the "human touched this" memory that makes the
/// sticky-choice law enforceable: machines never re-touch resolved ground.
model DiscoveryCategorySuggestion {
  id         String    @id @default(cuid())
  tenantId   String    @default("swift-default")
  itemId     String
  categoryId String
  confidence Decimal   @db.Decimal(3, 2)
  stage      String // "MATCHER" | "AI"
  status     String    @default("PENDING") // PENDING | ACCEPTED | DISMISSED | SUPERSEDED
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@unique([itemId, categoryId])
  @@index([tenantId, itemId, status])
  @@map("discovery_category_suggestions")
}

/// Vendors never create categories — they file requests into the founder's
/// queue (approve / merge into existing / reject, reason shown verbatim).
model DiscoveryCategoryRequest {
  id                 String    @id @default(cuid())
  tenantId           String    @default("swift-default")
  vendorId           String
  proposedName       String
  note               String?
  status             String    @default("PENDING") // PENDING | APPROVED | MERGED | REJECTED
  resolvedCategoryId String?
  resolvedBy         String?
  resolvedNote       String?
  createdAt          DateTime  @default(now())
  resolvedAt         DateTime?

  @@index([tenantId, status])
  @@map("discovery_category_requests")
}

/// Retention rollup target: per-day counts by decision/os/template. The
/// analytics endpoint sums raw + rollup so numbers survive the purge.
model ScanDailyRollup {
  id       String       @id @default(cuid())
  tenantId String       @default("swift-default")
  qrCodeId String
  date     DateTime     @db.Date
  decision ScanDecision
  osFamily String?
  template String?
  count    Int

  @@unique([tenantId, qrCodeId, date, decision, osFamily, template])
  @@index([tenantId, qrCodeId, date])
  @@map("scan_daily_rollups")
}
