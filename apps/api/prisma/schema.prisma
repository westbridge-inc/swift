  direction    String
  description  String
  reference    String?
  externalRef  String?
  balanceAfter Decimal         @db.Decimal(12, 2)
  createdAt    DateTime        @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("transactions")
}

enum TransactionType {
  ORDER_PAYMENT
  ORDER_REFUND
  WALLET_TOPUP
  WALLET_WITHDRAWAL
  SUBSCRIPTION_PAYMENT
  EARNING_PAYOUT
  TIP_RECEIVED
  PROMO_CREDIT
  ADJUSTMENT
}

// ==========================================
// PROMOTIONS
// ==========================================

model PromoCode {
  id             String       @id @default(cuid())
  code           String       @unique
  description    String
  /// null = platform-wide (admin-issued). Set = the vendor's own promotion
  /// (master plan §4.2): validated against and discounted from that vendor's
  /// plan only at checkout.
  vendorId       String?
  vendor         Vendor?      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(10, 2)
  minOrderAmount Decimal?     @db.Decimal(10, 2)
  maxDiscount    Decimal?     @db.Decimal(10, 2)
  applicableTo   OrderType[]
  validFrom      DateTime
  validUntil     DateTime
  maxUses        Int?
  maxUsesPerUser Int          @default(1)
  currentUses    Int          @default(0)
  isActive       Boolean      @default(true)
  orders         Order[]
  createdAt      DateTime     @default(now())

  @@index([vendorId])
  @@map("promo_codes")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_DELIVERY
}

// ==========================================
// NOTIFICATIONS
// ==========================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  /// [REPORT-034 #30] Caller-supplied idempotency key. Every BullMQ job runs
  /// with bounded retries, so any notification sent inside one could duplicate
  /// on retry — same inbox row twice, same push twice. NULL rows are unlimited
  /// (Postgres treats NULLs as distinct under the unique), so existing callers
  /// are untouched; a caller that passes a deterministic key gets exactly-once.
  dedupeKey String?

  @@unique([userId, dedupeKey])
  @@index([userId, isRead])
  @@map("notifications")
  @@index([createdAt]) // retention sweep cutoff [F-021-20]
}

enum NotificationType {
  ORDER_UPDATE
  PROMOTION
  SUBSCRIPTION_REMINDER
  SUBSCRIPTION_EXPIRED
  PAYMENT_RECEIVED
  EARNING_AVAILABLE
  RATING_RECEIVED
  SYSTEM_ANNOUNCEMENT
  CHAT_MESSAGE
  LOW_STOCK
  SAFETY // Trip Guardian check-ins + safety-system messages (spec §5.3; bodies stay minimal per §15)
}

