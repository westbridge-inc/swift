// ==========================================
// ZONES
// ==========================================

model Zone {
  id              String   @id @default(cuid())
  name            String
  description     String?
  boundary        Json
  isActive        Boolean  @default(true)
  deliveryBaseFee Decimal? @db.Decimal(10, 2)
  deliveryPerKm   Decimal? @db.Decimal(10, 2)
  surgeMultiplier Float    @default(1.0)
  riders          Rider[]  @relation("riderZones")
  faresFrom       ZoneFare[] @relation("zoneFareFrom")
  faresTo         ZoneFare[] @relation("zoneFareTo")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("zones")
}

/// Admin-editable zone-to-zone fixed taxi fares. When a
/// trip's ends both resolve to zones with a row here, this price wins; gaps
/// fall back to the CountryConfig formula. Directional on purpose (airport
/// runs can price differently each way).
model ZoneFare {
  id         String  @id @default(cuid())
  fromZoneId String
  fromZone   Zone    @relation("zoneFareFrom", fields: [fromZoneId], references: [id], onDelete: Cascade)
  toZoneId   String
  toZone     Zone    @relation("zoneFareTo", fields: [toZoneId], references: [id], onDelete: Cascade)
  fare       Decimal @db.Decimal(10, 2)
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([fromZoneId, toZoneId])
  @@map("zone_fares")
}

