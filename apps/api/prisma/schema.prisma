generator client {
  provider        = "prisma-client-js"
  // metrics: exposes the live connection-pool counters ($metrics.json()) that
  // the observability plugin turns into the swift_db_pool gauge (D7-04).
  previewFeatures = ["metrics"]
  // Native = local dev (macOS/host). The two linux targets let the SAME
  // generated client run in the deploy Docker image, whether the base is
  // glibc (debian-slim → openssl-3.0.x) or musl (alpine). Without these the
  // container throws "query engine not found" at boot. [deploy]
  binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USERS & AUTH
// ==========================================

model User {
  id               String     @id @default(cuid())
  phone            String     @unique
  email            String?    @unique
  firstName        String
  lastName         String
  avatar           String?
  /// Set only by POST /auth/selfie (camera capture in-app). The mandatory
  /// signup selfie (master plan §3) — null means the account has not completed
  /// it and the transact gates (orders / rides / go-online) stay closed.
  selfieCapturedAt DateTime?
  roles            UserRole[]
  activeRole       UserRole
  /// Last specific operational mover surface. Preserved while the user visits
  /// Customer/Business so a dual Rider+Driver account returns to the correct
  /// work app across devices and reinstalls. Null means genuinely unknown.
  lastMoverRole    MoverRole?
  status           UserStatus @default(ACTIVE)
  isPhoneVerified  Boolean    @default(false)
  isEmailVerified  Boolean    @default(false)

  /// DPA-2023 consent demonstrability [SWIFT-AUD-D9-03]: stamped at signup
  /// when the client sends acceptTerms; tosVersion = the LEGAL_VERSION served
  /// at that moment. Null on accounts created before consent recording (or by
  /// old clients while CONSENT_REQUIRED is off).
  acceptedTermsAt DateTime?
  tosVersion      String?

  /// Locked domain model: L1 phone-verified (mandatory), L2 ID-verified
  /// (required for orders >= the CountryConfig USD-equivalent gate), L3 earned.
  trustLevel TrustLevel @default(L1)

  /// ISO-3166 alpha-2; picked at signup from active CountryConfigs.
  countryCode String @default("GY")
  /// SaaS tenant (operator instance). DB-defaulted to the single current tenant
  /// so every existing + new row is assigned with no app change (stage 1).
  tenantId    String @default("swift-default")
  tenant      Tenant @relation(fields: [tenantId], references: [id])

  /// Email+password login lands later; phone OTP remains primary.
  passwordHash        String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  /// Channel switches { push, sms, email } — the vendor order alert ignores these
  notificationPrefs Json?

  /// Trip Guardian enhanced monitoring — "Extra safety check-ins on my trips"
  /// (safety spec §5.1). OPT-IN ONLY, set solely by the user's own toggle:
  /// never inferred from gender or any other attribute (protected data).
  enhancedSafetyMonitoring Boolean @default(false)

  addresses    Address[] @relation("userAddresses")
  lastKnownLat Float?
  lastKnownLng Float?

  /// V1 dormant — cash-only. Do not build on; Part C wallet rework.
  walletBalance Decimal @default(0) @db.Decimal(12, 2)

  verificationDocuments VerificationDocument[]
  complianceViolations  ComplianceViolation[]
  complianceReviews     ComplianceReviewCase[]
  strikes               Strike[]

  deviceTokens DeviceToken[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lastActiveAt DateTime?

  customer               Customer?
  rider                  Rider?
  driver                 Driver?
  vendorOwner            VendorOwner?
  vendorStaffMemberships VendorStaff[]         @relation("vendorStaffMemberships")
  serviceProvider        ServiceProvider?
  admin                  Admin?
  orders                 Order[]               @relation("customerOrders")
  ratings                Rating[]              @relation("raterRatings")
  ratingsReceived        Rating[]              @relation("rateeRatings")
  serviceJobs            ServiceJob[]          @relation("customerServiceJobs")
  notifications          Notification[]
  transactions           Transaction[]
  sessions               Session[]
  accountRecoveries      AccountRecovery[]
  payoutRequests         PayoutRequest[]
  payoutSchedule         PayoutSchedule?
  cart                   Cart?
  chatParticipants       ChatRoomParticipant[]
  supportTickets         SupportTicket[]
  resolvedTickets        SupportTicket[]       @relation("supportResolver")

  @@index([tenantId])
  @@map("users")
}

enum UserRole {
  CUSTOMER
  RIDER
  DRIVER
  /// Locked model role: unified rider+driver. Rider/Driver values are legacy;
  /// Onboarding creates MOVER accounts; Rider/Driver flows fold into MOVER.
  MOVER
  VENDOR_OWNER
  ADMIN
  SUPER_ADMIN
}

enum MoverRole {
  RIDER
  DRIVER
}

enum TrustLevel {
  L1
  L2
  L3
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
  DEACTIVATED
}

model Session {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token                String    @unique
  refreshToken         String    @unique
  /// Durable authentication assurance for this exact session generation.
  /// Existing/pre-cutover rows intentionally remain LEGACY and can continue
  /// serving non-privileged accounts, but can never inherit platform-admin
  /// authority. Only OTP is approved for ADMIN/SUPER_ADMIN until ADR-001's
  /// managed-identity/WebAuthn follow-up adds another explicit assurance.
  authMethod            SessionAuthMethod @default(LEGACY)
  // Refresh rotation theft detection: the token this one replaced, and when.
  // A replay of previousRefreshToken outside the race-grace window means the
  // token was stolen — the whole session is revoked (see AuthService.refreshTokens).
  previousRefreshToken String?   @unique
  rotatedAt            DateTime?
  deviceId             String
  deviceType           String
  ipAddress            String?
  userAgent            String?
  expiresAt            DateTime
  createdAt            DateTime  @default(now())

  @@map("sessions")
  @@index([expiresAt]) // retention sweep cutoff [F-021-20]
}

enum SessionAuthMethod {
  LEGACY
  PASSWORD
  OTP
}

/// Transactional outbox for session/security revocations that retire mover
/// supply. The authoritative order/profile/session change and this row commit
/// together; a worker retries Redis cleanup and redispatch after process death.
/// Customer notices and custody IncidentCases are persisted in that same
/// transaction, so this queue never substitutes an ephemeral signal for proof.
model MoverRevocationOutbox {
  id          String    @id
  dedupeKey   String    @unique
  userId      String
  payload     Json
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  claimedAt   DateTime?
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([processedAt, availableAt])
  @@index([claimedAt])
  @@map("mover_revocation_outbox")
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("device_tokens")
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("userAddresses", fields: [userId], references: [id], onDelete: Cascade)
  label        String
  addressLine1 String
  addressLine2 String?
  city         String
  region       String
  country      String   @default("GY")
  latitude     Float
  longitude    Float
  instructions String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("addresses")
}

// ==========================================
// COUNTRY CONFIG (multi-country from day 1)
// ==========================================

/// Wraps everything country-specific: currency, ID-gate threshold,
/// subscription tiers, required-document checklists. Adding a country
/// must be config, not code.
/// A marketplace operator instance (the SaaS tenant). Today there is exactly
/// one — Westbridge's Swift, operating across the Caribbean markets. A future
/// white-label licensee running their own Swift is a separate tenant, fully
/// isolated. `countryCode`/CountryConfig are the MARKET dimension WITHIN a
/// tenant, not the tenant boundary. Multi-tenancy foundation (stage 1): every
/// tenant-owned root carries `tenantId`; enforcement (RLS) lands in stage 2.
model Tenant {
  id        String   @id @default(cuid())
  /// Human name ("Swift").
  name      String
  /// URL/route-safe key, unique across operators.
  slug      String   @unique
  isActive  Boolean  @default(true)
  /// Per-tenant branding/config/billing (JSON until it needs columns).
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  vendors          Vendor[]
  orders           Order[]
  rideQueueEntries RideQueueEntry[]
  adRefundIntents  AdRefundIntent[]
  adRefundItems    AdRefundItem[]
  adRefundOutbox   AdRefundOutbox[]

  @@map("tenants")
}

model CountryConfig {
  id                 String  @id @default(cuid())
  /// ISO-3166 alpha-2 ("GY")
  code               String  @unique
  name               String
  currencyCode       String
  currencySymbol     String  @default("$")
  /// Local currency units per 1 USD — used to evaluate the USD ID-gate locally
  usdExchangeRate    Decimal @db.Decimal(12, 4)
  /// Orders >= this USD-equivalent require trust level L2 (ID-verified)
  idGateThresholdUsd Decimal @default(50) @db.Decimal(10, 2)
  /// D.3 rider float gate — max vendor-cash a rider may front at once, by trust
  /// level (local currency). L1 lowest → L3 highest.
  floatL1            Decimal @default(0) @db.Decimal(12, 2)
  floatL2            Decimal @default(0) @db.Decimal(12, 2)
  floatL3            Decimal @default(0) @db.Decimal(12, 2)
  /// Weekly subscription tiers in local currency:
  /// { mover, smallVendor, largeVendor, franchisePerStore? }
  subscriptionTiers  Json
  /// Required documents per role, e.g. { MOVER: ["national_id","drivers_licence",...], RESTAURANT: [...] }
  documentChecklists Json
  /// Taxi fare formula fallback (zone table wins when both ends match):
  /// { base, perKm, perMin, minimum } in local currency
  taxiRates          Json?
  /// Per-tier fare multipliers applied to the base (Economy) fare:
  /// { ECONOMY: 1.0, COMFORT: 1.35, XL: 1.8 }. Code default when null.
  taxiClassRates     Json?
  /// Courier fee formula [UG-CRAFT-03], local currency; code defaults when
  /// null (same pattern as taxiRates): { baseFee, perKmRate,
  /// sizeSurcharge: {SMALL..EXTRA_LARGE}, speedMultiplier: {STANDARD..RUSH} }
  courierRates       Json?
  /// FUL-003b: food/grocery delivery-fee schedule, local currency; code
  /// defaults when null (same pattern as courierRates/taxiRates):
  /// { baseFee, perKmRate, includedKm, surgeMultiplier }
  deliveryRates      Json?

  /// Cash guarantee + strike thresholds:
  /// { maxClaimsPerRiderPerMonth, strikeRestrictThreshold, strikeBanThreshold,
  ///   l3MinPaidOrders, l3MinAccountAgeDays, outlierMultiplier }
  cashRules Json?

  /// DPA §3.5 — region documents are stored in (cross-border transfer rule)
  storageRegion     String?
  /// Days to retain verification documents after a participant leaves
  dataRetentionDays Int     @default(365)

  /// Region-specific labels/sources (spec §2.2) — never hardcode in features.
  /// Guyana: "Hire Car Licence" / "Hire"; Trinidad: "H-Taxi Badge" / "H".
  taxiCredentialName  String?
  insuranceClassName  String?
  /// Verification registries/APIs available, e.g. ["ID Analyzer","GESW","GEI"]
  verificationSources Json?
  regulatoryNotes     String?
  /// BCP-47 locale, e.g. "en-GY"
  locale              String  @default("en")

  /// Inactive countries show a waitlist at signup
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("country_configs")
}

// ==========================================
// TRUST & VERIFICATION (L1/L2/L3 + strikes)
// ==========================================

model VerificationDocument {
  id                   String                     @id @default(cuid())
  userId               String
  user                 User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Which role this document supports (vendor docs, mover docs, customer L2 ID)
  role                 UserRole
  /// Checklist key from CountryConfig.documentChecklists (e.g. "national_id")
  docType              String
  /// Storage fileKey only (never a public URL). Raw documents: private +
  /// encrypted at rest, viewed via short-lived signed URLs, never logged,
  /// never sent to any AI service (hard rule 3 / DPA §3.5).
  fileUrl              String
  /// Provider case reference — the only provider-side artifact we keep
  kycRef               String?
  status               VerificationDocumentStatus @default(PENDING)
  /// OCR'd / manually entered expiry; lapse of a critical doc auto-suspends listings
  expiresAt            DateTime?
  reviewedBy           String?
  reviewNote           String?
  reviewedAt           DateTime?
  /// Insurance 5-point manual check (spec §3.4) — captured when an admin reviews
  /// a hire-insurance document. The taxi go-live gate requires HIRE + confirmed.
  insurerName          String?
  policyNumber         String?
  coverageClass        CoverageClass?
  hireClassConfirmed   Boolean                    @default(false)
  plateCrossChecked    Boolean                    @default(false)
  /// DPA §3.5 consent captured at upload (privacy notice acknowledged)
  consentAt            DateTime?
  privacyNoticeVersion String?
  /// Retention (DPA §3.5): the purge job deletes the stored object after this
  /// time and records purgedAt. Set when a participant leaves / is deactivated.
  retentionExpiresAt   DateTime?
  purgedAt             DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([status])
  @@index([userId])
  @@index([expiresAt])
  @@index([retentionExpiresAt])
  @@map("verification_documents")
}

/// Liability shield (founder directive 2026-07-15): the ENFORCEMENT layer
/// (expiry sweep, go-online gate) keeps bad actors off the road; this AUDIT
/// layer proves it. Every run snapshots who was online and whether their
/// checklist held — immutable evidence that the platform checked.
model ComplianceAuditRun {
  id            String    @id @default(cuid())
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  /// Movers who were online (live-operating) when the run executed
  moversChecked Int       @default(0)
  violations    Int       @default(0)
  /// MANUAL (admin button) or SCHEDULED (daily job)
  trigger       String    @default("SCHEDULED")

  @@index([startedAt])
  @@map("compliance_audit_runs")
}

/// One mover found live-operating without a valid checklist. The evidence
/// field freezes the per-document state at detection time (docType/status/
/// expiry) — what a court or regulator asks for.
model ComplianceViolation {
  id          String    @id @default(cuid())
  runId       String?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// RIDER | DRIVER (which live table they were online in)
  moverKind   String
  /// docs | insurance — the gate reason that failed
  reason      String
  evidence    Json
  actionTaken String    @default("FORCED_OFFLINE")
  createdAt   DateTime  @default(now())
  /// Set when the mover re-verifies (their checklist passes again)
  resolvedAt  DateTime?

  @@index([userId])
  @@index([createdAt])
  @@index([resolvedAt])
  @@map("compliance_violations")
}

/// Random re-verification (fraud catch): a monthly sample of active movers is
/// queued for a human re-review of their documents, regardless of expiry.
model ComplianceReviewCase {
  id        String                 @id @default(cuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    ComplianceReviewStatus @default(OPEN)
  dueAt     DateTime
  decidedBy String?
  decidedAt DateTime?
  note      String?
  createdAt DateTime               @default(now())

  @@index([status])
  @@index([userId])
  @@map("compliance_review_cases")
}

/// Supply watcher (availability spec §5): a customer who hit "no drivers
/// nearby" asks to be told when supply returns. One active watch per
/// customer; the scan notifies once and stamps, watches expire in 2h.

/// Rides spec 5.5B — the supply-gap queue: a WAITING entry is a promised
/// auto-request. Position is derived (createdAt FIFO among WAITING), never
/// stored; the 2-min supply scan claims the head via CAS and creates the ride
/// through the SAME request path the route uses. Additive-only (17.2).
model RideQueueEntry {
  id                String    @id @default(cuid())
  customerId        String
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  pickupLat         Float
  pickupLng         Float
  pickupAddress     String
  dropoffLat        Float
  dropoffLng        Float
  dropoffAddress    String
  rideClass         String    @default("ECONOMY")
  passengerCount    Int       @default(1)
  status            String    @default("WAITING") // WAITING | MATCHED | EXPIRED | LEFT
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  matchedOrderId    String?
  expiredNotifiedAt DateTime?

  @@index([status, expiresAt])
  @@index([customerId, status])
  @@index([tenantId, status, expiresAt, createdAt])
  @@map("ride_queue_entries")
}

model SupplyWatch {
  id         String    @id @default(cuid())
  // [REPORT-014 F-014-03] Watches are tenant-scoped: driver-demand counts and
  // supply-recovery notifications must never read another tenant's watchers.
  tenantId   String    @default("swift-default")
  customerId String
  pool       String // DRIVER | RIDER
  lat        Float
  lng        Float
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  notifiedAt DateTime?

  @@index([notifiedAt, expiresAt])
  @@index([customerId])
  @@map("supply_watches")
}

/// Search journal (availability spec §3): one row per dispatch search, written
/// BESIDE the order/ride state machines — never inside them. Journaling is
/// fire-and-caught; dispatch never fails on it. A retry after exhaustion opens
/// a FRESH row (the exhausted one keeps its resolution).
model DispatchSearch {
  id              String    @id @default(cuid())
  vertical        String // TAXI | DELIVERY | COURIER
  subjectType     String    @default("ORDER")
  subjectId       String
  status          String // SEARCHING | ASSIGNED | EXHAUSTED | CANCELLED
  wave            Int       @default(1)
  radiusKm        Float
  candidatesTried String[]  @default([])
  startedAt       DateTime  @default(now())
  assignedAt      DateTime?
  assignedTo      String?
  exhaustedAt     DateTime?
  resolution      String? // RETRIED | SWITCHED_PICKUP | CANCELLED | WATCHING | MANUAL

  @@index([status, startedAt])
  @@index([subjectId])
  @@map("dispatch_searches")
}

/// Alert delivery tracking (alerts spec §A4): every money-critical alert
/// (vendor new-order, mover offer) writes a row at send and stamps
/// acknowledgedAt when the recipient ACTS (accept/reject/ack). Ack-rate and
/// time-to-ack are how silently-failing pushes get caught before churn.
model AlertDelivery {
  id             String    @id @default(cuid())
  kind           String // VENDOR_ORDER | MOVER_OFFER
  subjectId      String // orderId
  recipientId    String // userId
  sentAt         DateTime  @default(now())
  /// The recipient's client RENDERED the alert (offer card displayed) —
  /// distinct from acknowledgedAt (the recipient ACTED). [danger #21] An
  /// offer that times out with neither stamp is UNDELIVERABLE: the mover
  /// provably never saw it, so it must not decay their acceptance rate.
  seenAt         DateTime?
  acknowledgedAt DateTime?
  /// [REPORT-014 F-014-04] Which offer ATTEMPT this row is evidence for. A
  /// re-offer of the same order to the same mover is a NEW attempt; timeout
  /// accounting must read exactly its own attempt's render proof, never an
  /// older row's. Null on legacy rows and non-offer kinds.
  offerAttemptId String?

  @@index([kind, sentAt])
  @@index([subjectId, recipientId])
  @@map("alert_deliveries")
}

/// [DCR-1 CW] One Commencement-Watch scan of one source. The watch OBSERVES
/// and alerts — it never moves legal state (only the founder CLI does).
model CwRun {
  id          String   @id @default(cuid())
  sourceId    String
  httpStatus  Int?
  listingHash String?
  entriesSeen Int      @default(0)
  hits        Int      @default(0)
  error       String?
  ranAt       DateTime @default(now())

  @@index([sourceId, ranAt])
  @@map("cw_runs")
}

/// [DCR-1 CW] A detected event. content_hash dedupes across scans; the big
/// three re-notify daily until a human acknowledges.
model CwAlert {
  id             String    @id @default(cuid())
  /// COMMENCEMENT | REGULATIONS | OFFICE_NEWS | REGISTRATION_OPEN | WATCH_DEGRADED
  eventType      String
  /// CONFIRMED-CANDIDATE | SIGNAL | SYSTEM
  confidence     String
  sourceId       String
  matchedRule    String
  entryTitle     String
  entryUrl       String?
  contentHash    String    @unique
  firstSeenAt    DateTime  @default(now())
  notifiedAt     DateTime?
  acknowledgedBy String?

  @@index([eventType, acknowledgedBy])
  @@map("cw_alerts")
}

/// [DCR-1 NR-2] A retention rule: rows of one data class may not outlive
/// their window. The registry is DATA, not code — the sweep reads it, the
/// registration pack compiles it, and changing a window is an auditable row
/// update, not a deploy.
model RetentionPolicy {
  id          String   @id @default(cuid())
  /// e.g. sessions.expired | signup_attempts | notifications.old
  dataClass   String   @unique
  description String
  /// The clock: rows older than this many days (per the class's own
  /// timestamp) are due for deletion on the next sweep.
  retainDays  Int
  /// Why this window is lawful/needed — cited in the registration pack.
  legalBasis  String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("retention_policies")
}

/// [DCR-1 NR-2] Sweep receipts — the demonstrable-compliance trail that the
/// clocks actually run. One row per (policy, sweep run).
model RetentionSweepReceipt {
  id         String   @id @default(cuid())
  dataClass  String
  /// Rows strictly older than this instant were in scope.
  cutoff     DateTime
  deleted    Int
  durationMs Int
  ranAt      DateTime @default(now())

  @@index([dataClass, ranAt])
  @@map("retention_sweep_receipts")
}

/// [DCR-1 NR-1] The consent ledger. Guyana's DPA is enacted but not in force;
/// consent for accounts created in the gap cannot be manufactured on commencement
/// day, so it is captured now, hash-anchored to the exact text the user saw.
model LegalDocument {
  id           String   @id @default(cuid())
  /// privacy_policy | terms_of_service | driver_agreement | vendor_agreement
  /// | marketing_consent | location_bg_consent
  documentType String
  version      String
  locale       String   @default("en-GY")
  /// sha256 of the exact rendered text served to users at this version.
  contentHash  String
  /// [F-021-24] The EXACT text itself — the hash alone cannot answer
  /// "which words" years later if the constant leaves the codebase.
  renderedText String?
  /// NULL = draft. Consent may never reference a draft (INV-NR1b).
  publishedAt  DateTime?
  createdAt    DateTime @default(now())

  @@unique([documentType, version, locale])
  @@map("legal_documents")
}

/// APPEND-ONLY (INV-NR1c): withdrawals and re-grants are NEW ROWS, never updates.
/// Enforced by a database trigger + revoked privileges, not by convention.
model ConsentRecord {
  id                  String   @id @default(cuid())
  /// customer | driver | vendor_user | admin
  subjectType         String
  subjectId           String
  documentType        String
  documentVersion     String
  /// Must equal the published LegalDocument.contentHash for that version.
  documentContentHash String
  /// granted | withdrawn | re_granted
  action              String
  /// ios | android | web | vendor_web | admin | support_ticket
  surface             String
  locale              String   @default("en-GY")
  capturedAt          DateTime @default(now())
  /// HMAC-SHA256(ip, CONSENT_IP_PEPPER) — the raw IP is never stored here.
  ipHmac              String?
  appVersion          String?
  /// {"control":"checkbox","control_id":"pp_v1_signup","screen":"..."}
  evidence            Json     @default("{}")

  @@index([subjectType, subjectId, documentType, capturedAt])
  @@map("consent_records")
}

enum ComplianceReviewStatus {
  OPEN
  PASSED
  FAILED
}

/// Envelope-encryption metadata for a stored verification object (onboarding
/// spec §5): the object in the bucket is AES-256-GCM ciphertext; the per-file
/// DEK lives here wrapped by the master KEK. Nulling wrappedDek is the
/// crypto-shred — the ciphertext (and any backup of it) becomes permanently
/// unrecoverable. Keyed by fileKey because upload happens before the
/// VerificationDocument row exists (two-step upload → submit).
model EncryptedObject {
  fileKey    String    @id
  iv         Bytes
  authTag    Bytes
  wrappedDek Bytes?
  mimeType   String
  sizeBytes  Int
  sha256     String
  createdBy  String
  createdAt  DateTime  @default(now())
  shreddedAt DateTime?

  @@map("encrypted_objects")
}

enum VerificationDocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

/// Motor-insurance class for taxi drivers (spec §3.4). HIRE = fare-paying
/// passengers (required to carry passengers); PRIVATE never qualifies.
enum CoverageClass {
  HIRE
  PRIVATE
}

/// Company guarantee for failed cash handovers under the USD gate
/// Status is decided by deterministic guardrails —
/// caps/outliers/collusion route to manual review, never auto-payout.
model ReimbursementClaim {
  id         String      @id @default(cuid())
  orderId    String      @unique
  riderId    String
  customerId String
  amount     Decimal     @db.Decimal(12, 2)
  /// no_show | refused
  reason     String
  /// Golden-rule evidence — captured at the door, claim impossible without it
  gpsLat     Float
  gpsLng     Float
  photoUrl   String?
  status     ClaimStatus @default(PENDING_REVIEW)
  /// Deterministic guardrail flags: over_cap, outlier, collusion_customer, collusion_pair
  flags      String[]
  reviewedBy String?
  reviewNote String?
  reviewedAt DateTime?
  paidAt     DateTime?
  paymentRef String?
  createdAt  DateTime    @default(now())

  @@index([riderId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("reimbursement_claims")
}

enum ClaimStatus {
  AUTO_APPROVED
  PENDING_REVIEW
  APPROVED
  REJECTED
  PAID
}

/// Customer strike for cash no-shows / refusals.
/// Phone + address fingerprint captured for collusion detection.
model Strike {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId    String?
  reason     String
  phone      String?
  addressKey String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([phone])
  @@map("strikes")
}

// ==========================================
// CUSTOMER
// ==========================================

model Customer {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  favoriteVendors Vendor[] @relation("customerFavorites")
  totalOrders     Int      @default(0)
  totalSpent      Decimal  @default(0) @db.Decimal(12, 2)
  referralCode    String   @unique @default(cuid())
  referredBy      String?
  createdAt       DateTime @default(now())

  @@map("customers")
}

// ==========================================
// RIDERS (Delivery + Courier)
// ==========================================

model Rider {
  id                       String                   @id @default(cuid())
  userId                   String                   @unique
  user                     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  riderType                RiderType
  vehicleType              VehicleType
  vehicleMake              String?
  vehicleModel             String?
  vehicleYear              Int?
  vehicleColor             String?
  licensePlate             String?
  nationalIdUrl            String?
  driverLicenseUrl         String?
  vehicleInsuranceUrl      String?
  profilePhotoUrl          String?
  /// PUBLIC delivery-vehicle photo shown to the customer on acceptance
  /// (master plan §3.3) — uploaded via POST /rider/vehicle-photo.
  vehiclePhotoUrl          String?
  documentsVerified        Boolean                  @default(false)
  documentsVerifiedAt      DateTime?
  documentsVerifiedBy      String?
  isOnline                 Boolean                  @default(false)
  isAvailable              Boolean                  @default(true)
  currentLat               Float?
  currentLng               Float?
  lastLocationUpdate       DateTime?
  /// Session that most recently won GO. Prevents two signed-in phones from
  /// alternately overwriting one mover's authoritative coordinates.
  locationSessionId        String?
  currentOrderId           String?
  /// §7.1 liveness shift cache — a PASS is good for LIVENESS_SHIFT_HOURS; the
  /// go-online gate reads this, never the provider directly.
  lastLivenessPassAt       DateTime?
  /// §7.1 — third consecutive liveness FAIL locks go-online until ops clears.
  livenessLockedAt         DateTime?
  /// §7.2 — a random mid-shift check is pending; unanswered past this deadline
  /// the sweep forces the mover offline until a fresh PASS.
  livenessPromptDeadlineAt DateTime?
  /// §8.3 — interim SUSPENDED_PENDING_REVIEW on an S0/S1 incident: invisible
  /// to dispatch instantly, go-online blocked until ops lifts it.
  safetySuspendedAt        DateTime?
  /// §8.3 — SHADOW_RESTRICTED (S2 option): stays online, but excluded from
  /// enhanced-monitoring passengers' trips pending review.
  safetyShadowRestrictedAt DateTime?
  operatingZones           Zone[]                   @relation("riderZones")
  totalDeliveries          Int                      @default(0)
  totalCourierJobs         Int                      @default(0)
  averageRating            Float                    @default(5.0)
  totalRatings             Int                      @default(0)
  completionRate           Float                    @default(100.0)
  /// % of dispatch offers accepted (EMA) — feeds candidate scoring
  acceptanceRate           Float                    @default(100.0)
  /// D.3 float gate — max vendor-cash this rider may front at once (derived from
  /// User.trustLevel via CountryConfig.floatL1/L2/L3); committedFloat = currently
  /// outstanding across live CASH orders. availableFloat = floatLimit - committedFloat.
  floatLimit               Decimal                  @default(0) @db.Decimal(12, 2)
  committedFloat           Decimal                  @default(0) @db.Decimal(12, 2)
  subscription             Subscription?
  earnings                 Earning[]
  orders                   Order[]
  deliveryCashSettlements  DeliveryCashSettlement[]
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@index([isOnline])
  @@index([isOnline, isAvailable])
  @@index([isAvailable])
  @@index([locationSessionId])
  // Readiness/cutover reverse-authority proof starts from the sparse live
  // pointer set. Keep this represented in Prisma so the supporting migration
  // cannot become an invisible, drift-only database index.
  @@index([currentOrderId])
  @@map("riders")
}

enum RiderType {
  DELIVERY
  COURIER
  BOTH
}

/// Body-type taxonomy for the vehicle visual system [rides spec 6B.2] —
/// trimmed to the Georgetown fleet reality plus headroom.
enum VehicleBodyType {
  SEDAN
  HATCHBACK
  WAGON
  SUV
  PICKUP
  MINIBUS
  COMPACT
  UNKNOWN
}

enum VehicleType {
  BICYCLE
  MOTORCYCLE
  CAR
  WAGON_CAR
  BUS_9
  BUS_15
  CANTER_SHORT
  CANTER_LONG
  BOX_TRUCK_SHORT
  BOX_TRUCK_LONG
}

// ==========================================
// DRIVERS (Taxi)
// ==========================================

model Driver {
  id                       String           @id @default(cuid())
  userId                   String           @unique
  user                     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleMake              String
  vehicleModel             String
  vehicleYear              Int
  vehicleColor             String
  licensePlate             String
  vehicleCapacity          Int              @default(4)
  /// The physical vehicle (drives the verification document checklist + the
  /// passenger-hire insurance gate). Defaults CAR so existing taxi drivers are
  /// unchanged; wagons/buses set their real type at onboarding.
  vehicleType              VehicleType      @default(CAR)
  /// Top taxi tier this vehicle serves (serves all classes <= it). Set via the
  /// driver-profile API and the admin drivers page (premium-fleet onboarding).
  rideClass                RideClass        @default(ECONOMY)
  /// Vehicle visual identity [rides spec 6B] — additive, nullable, every
  /// consumer handles null. bodyType from the make/model fleet mapping
  /// (UNKNOWN surfaces one-tap classification in admin — never guessed
  /// client-side); colorHex from the onboarding color word. The customer's
  /// card, map marker, and the car at the curb must be the same shape+tint.
  bodyType                 VehicleBodyType?
  colorHex                 String?
  nationalIdUrl            String?
  driverLicenseUrl         String
  vehicleInsuranceUrl      String
  vehicleInspectionUrl     String?
  profilePhotoUrl          String?
  /// PUBLIC exterior car photo shown to the rider on acceptance (master plan
  /// §5) — uploaded via POST /driver/vehicle-photo into the public vehicles/
  /// tree. Distinct from the private vehicle_exterior_photo KYC document.
  vehiclePhotoUrl          String?
  documentsVerified        Boolean          @default(false)
  documentsVerifiedAt      DateTime?
  documentsVerifiedBy      String?
  isOnline                 Boolean          @default(false)
  isAvailable              Boolean          @default(true)
  currentLat               Float?
  currentLng               Float?
  lastLocationUpdate       DateTime?
  /// Session that most recently won GO. Opaque on purpose: deleting an auth
  /// session invalidates it without a cross-domain foreign-key cascade.
  locationSessionId        String?
  currentRideId            String?
  /// §7.1 liveness shift cache — a PASS is good for LIVENESS_SHIFT_HOURS; the
  /// go-online gate reads this, never the provider directly.
  lastLivenessPassAt       DateTime?
  /// §7.1 — third consecutive liveness FAIL locks go-online until ops clears.
  livenessLockedAt         DateTime?
  /// §7.2 — a random mid-shift check is pending; unanswered past this deadline
  /// the sweep forces the mover offline until a fresh PASS.
  livenessPromptDeadlineAt DateTime?
  /// §8.3 — interim SUSPENDED_PENDING_REVIEW on an S0/S1 incident: invisible
  /// to dispatch instantly, go-online blocked until ops lifts it.
  safetySuspendedAt        DateTime?
  /// §8.3 — SHADOW_RESTRICTED (S2 option): stays online, but excluded from
  /// enhanced-monitoring passengers' trips pending review.
  safetyShadowRestrictedAt DateTime?
  totalRides               Int              @default(0)
  averageRating            Float            @default(5.0)
  totalRatings             Int              @default(0)
  acceptanceRate           Float            @default(100.0)
  cancellationRate         Float            @default(0.0)
  subscription             Subscription?
  earnings                 Earning[]
  orders                   Order[]
  /// The taxi driver's OWN MMG "pay me" link. Opt-in: when set, riders can pay
  /// the fare directly via MMG (money never touches Swift); null = cash-only.
  mmgPayUrl                String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  // Taxi dispatch filters online+available candidates before the PostGIS
  // ST_DWithin distance check (the GIST expression index lives in the
  // migration — mirrors riders_geo_gist).
  @@index([isOnline, isAvailable])
  @@index([isAvailable])
  @@index([locationSessionId])
  @@index([currentRideId])
  @@map("drivers")
}

// ==========================================
// VENDORS
// ==========================================

model VendorOwner {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendors   Vendor[]
  createdAt DateTime @default(now())

  @@map("vendor_owners")
}

/// Staff & roles (master plan §4.1): extra logins on a store. The OWNER
/// (VendorOwner) invites existing Swift accounts by phone; access flows
/// through resolveVendor exactly like ownership does.
///   MANAGER — runs the store: orders, menu, hours, insights
///   STAFF   — floor work: order queue + sold-out toggles
enum VendorStaffRole {
  MANAGER
  STAFF
}

model VendorStaff {
  id        String          @id @default(cuid())
  vendorId  String
  vendor    Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation("vendorStaffMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role      VendorStaffRole @default(STAFF)
  /// userId of the owner who added them (audit trail)
  invitedBy String
  createdAt DateTime        @default(now())

  @@unique([vendorId, userId])
  @@map("vendor_staff")
}

model Vendor {
  id                      String                   @id @default(cuid())
  tenantId                String                   @default("swift-default")
  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  ownerId                 String
  owner                   VendorOwner              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                    String
  slug                    String                   @unique
  description             String?
  vendorType              VendorType
  logoUrl                 String?
  coverImageUrl           String?
  images                  VendorImage[]
  staff                   VendorStaff[]
  promoCodes              PromoCode[]
  phone                   String
  email                   String?
  addressLine1            String
  addressLine2            String?
  city                    String
  region                  String
  latitude                Float
  longitude               Float
  operatingHours          OperatingHours[]
  isCurrentlyOpen         Boolean                  @default(false)
  /// Born OFF: commerce opens when the owner's document checklist is verified
  /// (verification afterApproval) and closes when a required document lapses.
  acceptingOrders         Boolean                  @default(false)
  /// FUL-004: this vendor can fulfil its own DELIVERY orders with its own
  /// courier (vs a platform rider). Default off — existing vendors are
  /// platform-rider-only until they opt in.
  selfDeliveryEnabled     Boolean                  @default(false)
  /// FUL-007: kitchen-capacity guard. When set, new orders are refused once
  /// the vendor already holds this many in-flight (still-in-kitchen) orders —
  /// server-computed so it can't be gamed. Null = unlimited (current behavior).
  maxConcurrentOrders     Int?
  deliveryRadius          Float                    @default(10.0)
  minOrderAmount          Decimal                  @default(0) @db.Decimal(10, 2)
  estimatedPrepTime       Int                      @default(30)
  categories              Category[]
  items                   Item[]
  isVerified              Boolean                  @default(false)
  // [REPORT-013 F-013-06] The wall-clock bound of the document authority
  // behind isVerified: min(expiresAt) over the checklist evidence, written
  // by the activation projection. Null = no expiring evidence bounds it
  // (legacy/grandfather or non-expiring docs). Checkout binds it in-tx so a
  // lapse between daily sweeps stops sales at the next order, not the next
  // sweep.
  activationValidUntil    DateTime?
  // [REPORT-013 F-013-07] WHO suspended the store: 'BILLING' (non-payment,
  // reversible by payment) or 'ADMIN' (manual/safety — payment must NOT
  // lift it). Reinstatement CAS-matches BILLING only.
  suspensionSource        String?
  isFeatured              Boolean                  @default(false)
  averageRating           Float                    @default(5.0)
  totalRatings            Int                      @default(0)
  totalOrders             Int                      @default(0)
  subscription            Subscription?
  settlements             Settlement[]
  deliveryCashSettlements DeliveryCashSettlement[]
  cuisineTypes            String[]
  tags                    String[]
  favoritedBy             Customer[]               @relation("customerFavorites")
  status                  VendorStatus             @default(PENDING_APPROVAL)
  orders                  Order[]
  carts                   Cart[]

  /// DORMANT (never wired to a route): superseded by the QrCode model, which
  /// owns printed-QR deep links via /s/{shortCode}. Kept only because rows
  /// carry values and the domain-model test pins uniqueness. Do not build on.
  qrSlug String @unique @default(cuid())

  /// The vendor's OWN MMG (Mobile Money Guyana) "pay me" link. Opt-in: when set,
  /// customers can pay this vendor directly via MMG (money never touches Swift);
  /// null = cash-only. A public pay URL, not a secret credential.
  mmgPayUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([vendorType])
  @@index([latitude, longitude])
  @@index([tenantId])
  @@map("vendors")
}

enum VendorType {
  RESTAURANT
  SUPERMARKET
  STORE
  SERVICE
}

enum VendorStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  CLOSED
}

model VendorImage {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("vendor_images")
}

model OperatingHours {
  id        String  @id @default(cuid())
  vendorId  String
  vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  openTime  String
  closeTime String
  isClosed  Boolean @default(false)

  @@map("operating_hours")
}

// ==========================================
// MENU / CATALOG
// ==========================================

model Category {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name        String
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  items       Item[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

/// The locked model's Listing: one model for goods AND services.
/// Services carry bookingConfig (duration, slots) and APPOINTMENT fulfillment.
model Item {
  id                String            @id @default(cuid())
  vendorId          String
  vendor            Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId        String
  category          Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  imageUrl          String?
  basePrice         Decimal           @db.Decimal(10, 2)
  fulfillment       FulfillmentType   @default(DELIVERY)
  /// SERVICE listings only: { durationMinutes: number, slots: [{ dayOfWeek, start, end }] }
  bookingConfig     Json?
  bookings          Booking[]
  optionGroups      OptionGroup[]
  isAvailable       Boolean           @default(true)
  isPopular         Boolean           @default(false)
  sku               String?
  barcode           String?
  unit              String?
  /// Items sharing a group are valid substitutes when one is out of stock
  /// at picking time (grocery §5.3). Null = substitute from the same category.
  substitutionGroup String?
  /// null = untracked (always in stock). Tracked items decrement atomically at
  /// checkout, auto-hide at 0, and restock on pre-pickup cancellation.
  stockQuantity     Int?
  /// At/under this level a LOW_STOCK alert goes to the owner (crossing-edge only).
  lowStockThreshold Int?
  /// Set when the inventory engine hid the item (stock hit 0) — distinguishes
  /// auto-hides (undone automatically on restock) from the owner's own toggle.
  autoHiddenAt      DateTime?
  dietaryTags       String[]
  allergens         String[]
  totalOrdered      Int               @default(0)
  sortOrder         Int               @default(0)
  cartItems         CartItem[]
  stockAdjustments  StockAdjustment[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Menu load (vendor detail, vendor console, reorder) is the hottest read in
  // the app; browse/trending filter on availability + popularity. Postgres
  // does not auto-index FK columns.
  @@index([vendorId])
  @@index([vendorId, isAvailable])
  @@index([isAvailable, totalOrdered])
  @@map("items")
}

enum FulfillmentType {
  DELIVERY
  APPOINTMENT
  PICKUP
}

/// FUL-004 (fulfillment Part 4): HOW a DELIVERY order actually reaches the
/// customer — a platform rider, the vendor's own courier, or counter pickup.
/// Distinct from FulfillmentType (what the CUSTOMER chose): the customer picks
/// delivery-vs-pickup, the vendor picks who delivers. Recorded on the order.
enum FulfillmentMode {
  PLATFORM_RIDER
  VENDOR_DELIVERY
  PICKUP
}

/// A reserved appointment slot on a SERVICE listing. Double-booking is
/// impossible at the data layer: a partial unique index on (itemId, slotStart)
/// WHERE status <> 'CANCELLED' (see the step6 migration — Prisma cannot
/// express partial uniques, so it lives in SQL).
model Booking {
  id         String        @id @default(cuid())
  itemId     String
  item       Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  customerId String
  /// Wired to the order at acceptance
  orderId    String?
  slotStart  DateTime
  slotEnd    DateTime
  status     BookingStatus @default(RESERVED)
  createdAt  DateTime      @default(now())

  @@index([itemId, slotStart])
  @@index([customerId])
  @@map("bookings")
}

enum BookingStatus {
  RESERVED
  CONFIRMED
  CANCELLED
  COMPLETED
}

/// One-off availability blocks (scheduling spec 2.1): vacation day, funeral
/// afternoon, lunch hour — subtracted from slot computation BEFORE bookings.
/// itemId null = the whole business is blocked; start/end null = full day.
/// Customers simply never see blocked slots; `reason` never leaves the vendor.
model BookingException {
  id        String   @id @default(cuid())
  tenantId  String   @default("swift-default")
  itemId    String?
  vendorId  String
  date      DateTime @db.Date
  start     String? // "13:00" local wall-clock (the UTC-face convention)
  end       String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([vendorId, date])
  @@map("booking_exceptions")
}

model OptionGroup {
  id         String   @id @default(cuid())
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name       String
  isRequired Boolean  @default(false)
  minSelect  Int      @default(0)
  maxSelect  Int      @default(1)
  options    Option[]
  sortOrder  Int      @default(0)

  @@map("option_groups")
}

model Option {
  id              String      @id @default(cuid())
  optionGroupId   String
  optionGroup     OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  name            String
  additionalPrice Decimal     @default(0) @db.Decimal(10, 2)
  isDefault       Boolean     @default(false)
  isAvailable     Boolean     @default(true)
  sortOrder       Int         @default(0)

  @@map("options")
}

// ==========================================
// ORDERS
// ==========================================

model Order {
  id                     String                  @id @default(cuid())
  tenantId               String                  @default("swift-default")
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  orderNumber            String                  @unique
  orderType              OrderType
  customerId             String
  customer               User                    @relation("customerOrders", fields: [customerId], references: [id])
  vendorId               String?
  vendor                 Vendor?                 @relation(fields: [vendorId], references: [id])
  riderId                String?
  rider                  Rider?                  @relation(fields: [riderId], references: [id])
  driverId               String?
  driver                 Driver?                 @relation(fields: [driverId], references: [id])
  status                 OrderStatus             @default(PENDING)
  statusHistory          OrderStatusLog[]
  deliveryCashSettlement DeliveryCashSettlement?
  items                  OrderItem[]
  supportTickets         SupportTicket[]

  pickupAddress        String?
  pickupLat            Float?
  pickupLng            Float?
  deliveryAddress      String
  deliveryLat          Float
  deliveryLng          Float
  deliveryInstructions String?

  courierPackageDescription String?
  courierPackageSize        PackageSize?
  courierPackageWeight      Float?
  courierPackagePhotoUrl    String?
  /// Courier (spec §4.3): third-party recipient, speed, who pays, proof-of-delivery,
  /// and a public tracking token for the recipient's link.
  courierRecipientName      String?
  courierRecipientPhone     String?
  courierSpeed              String?
  courierPayer              String?
  courierProofPhotoUrl      String?
  // [REPORT-016 F-016-04] The proof object the SERVER issued for this order at
  // /proof-photo, bound to the uploading rider. /proof requires an EXACT match
  // (not a substring) so a crafted or foreign URL can never terminalize a
  // delivery. Cleared implicitly once the order reaches DELIVERED.
  courierProofIssuedUrl     String?
  courierProofIssuedRiderId String?
  courierTrackingToken      String?      @unique

  taxiPickupAddress  String?
  taxiDropoffAddress String?
  taxiPassengerCount Int?
  taxiDistance       Float?
  taxiDuration       Int?

  subtotalBase     Decimal @db.Decimal(12, 2)
  /// V1 dormant — zero-commission model: markup must stay 0.
  /// Field removal happens with the Steps 6-7 catalogue/order rebuild.
  subtotalMarkup   Decimal @db.Decimal(12, 2)
  subtotalCustomer Decimal @db.Decimal(12, 2)
  deliveryFee      Decimal @db.Decimal(12, 2)
  serviceFee       Decimal @default(0) @db.Decimal(12, 2)
  taxAmount        Decimal @default(0) @db.Decimal(12, 2)
  tipAmount        Decimal @default(0) @db.Decimal(12, 2)
  discount         Decimal @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal @db.Decimal(12, 2)

  taxiFareBase   Decimal?   @db.Decimal(10, 2)
  taxiFarePerKm  Decimal?   @db.Decimal(10, 2)
  taxiFarePerMin Decimal?   @db.Decimal(10, 2)
  taxiFareTotal  Decimal?   @db.Decimal(10, 2)
  taxiFareSurge  Float?
  /// Chosen taxi tier (Economy/Comfort/XL). Null for non-taxi orders.
  rideClass      RideClass?

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  paymentId     String?
  /// Immutable direct-payment destination committed under the vendor row lock.
  /// Never fall back to the vendor's mutable profile URL for an existing order.
  mmgPayUrlSnapshot       String?
  mmgRecipientNameSnapshot String?

  estimatedPrepTime     Int?
  estimatedDeliveryTime Int?
  actualDeliveryTime    Int?
  /// Priority delivery (§4.2 parity with courier speed tiers): customer pays
  /// 1.5x the delivery fee, the order dispatches ahead of standard ones, and
  /// the whole premium goes to the rider (cash, no commission).
  isExpress             Boolean   @default(false)
  scheduledFor          DateTime?
  /// LIFECYCLE_V2 hold (spec Part A): while in the FUTURE the order is HIDDEN
  /// from the vendor and undispatched — the customer's free-cancel window.
  /// Cleared (null) by the release worker; the server clock is authoritative.
  holdExpiresAt         DateTime?
  /// Set exactly once when the hold releases (vendor notified + dispatchable).
  releasedToVendorAt    DateTime?
  placedAt              DateTime  @default(now())
  acceptedAt            DateTime?
  preparingAt           DateTime?
  readyAt               DateTime?
  pickedUpAt            DateTime?
  deliveredAt           DateTime?
  cancelledAt           DateTime?

  cancelledBy        String?
  cancellationReason String?
  /// Late-cancel fee ANNOUNCED at cancellation (GYD int; 0 = cancelled free).
  /// Founder decision 2026-07-20: cash-only means Swift can't collect it — its
  /// role is the risk-score marker ("customer cancels after the free window")
  /// and admin visibility. Never charged, never summed into money totals.
  lateCancelFeeDue   Int     @default(0)

  promoCodeId String?
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id])

  /// QR growth engine: which client placed the order (null = pre-feature
  /// mobile). Stamped WEB by the web checkout; mobile stays null until the
  /// mobile client opts in. Never business logic — measurement only.
  channel             String?
  /// The QrCode a scanned customer arrived through (?c= param carried to
  /// checkout). "Orders from this QR" on the vendor dashboard reads this.
  attributionQrCodeId String?

  ridePin            String?
  ridePinVerified    Boolean   @default(false)
  ridePinAttempts    Int       @default(0)
  ridePinVerifiedAt  DateTime?
  /// HND-001: failed pickup-code attempts, for the same brute-force lockout the
  /// taxi ride PIN already has (a 6-digit handover code is guessable without it).
  pickupCodeAttempts Int       @default(0)

  /// How this order is fulfilled (locked model): DELIVERY dispatches a mover,
  /// PICKUP skips dispatch, APPOINTMENT books the slot at vendor acceptance.
  fulfillment     FulfillmentType  @default(DELIVERY)
  /// FUL-004: who actually delivers this order (set when the vendor chooses at
  /// Ready). NULL on orders predating the choice — treated as PLATFORM_RIDER.
  fulfillmentMode FulfillmentMode?
  appointmentSlot DateTime?
  /// Takeaway: 4-digit code the customer shows to collect a PICKUP order; the
  /// vendor verifies it to close the order (no rider involved). Null otherwise.
  pickupCode      String?

  /// Deterministic risk heuristic (new account + high value + odd hours):
  /// the vendor sees a call-to-confirm prompt. Never an AI decision.
  riskFlagged Boolean @default(false)
  riskReason  String?

  tripShares TripShareToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([vendorId])
  @@index([riderId])
  @@index([driverId])
  @@index([status])
  @@index([placedAt])
  @@index([customerId, status])
  // Release-worker tick: WHERE status=PENDING AND holdExpiresAt <= now
  @@index([status, holdExpiresAt])
  // The vendor order board reads "my orders in these states" constantly.
  @@index([vendorId, status])
  @@index([tenantId])
  // "Orders from this QR" (vendor analytics); null-heavy so cheap.
  @@index([attributionQrCodeId])
  @@map("orders")
}

enum OrderType {
  FOOD_DELIVERY
  GROCERY_DELIVERY
  COURIER
  TAXI
}

/// Taxi vehicle tier. A driver's rideClass is the TOP class their vehicle
/// serves (serves all classes <= it). Seat capacity is a code rule:
/// ECONOMY/COMFORT = 4, XL = 6. Per-class fare multipliers live in
/// CountryConfig.taxiClassRates (code default when null).
enum RideClass {
  ECONOMY
  COMFORT
  XL
  GROUP
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  RIDER_ASSIGNED
  RIDER_EN_ROUTE_PICKUP
  RIDER_ARRIVED_PICKUP
  PICKED_UP
  EN_ROUTE_DELIVERY
  ARRIVED
  DRIVER_ASSIGNED
  DRIVER_EN_ROUTE
  DRIVER_ARRIVED
  RIDE_IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
  FAILED
}

enum PackageSize {
  SMALL
  MEDIUM
  LARGE
  EXTRA_LARGE
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  CARD
  WALLET // V1 dormant — wallet surface removed; reserved for Part C BaaS. No customer path emits this.
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  /// Money may have moved but cannot be confirmed [tollgate LAW M-5] — never
  /// auto-failed, never auto-succeeded; ages into the admin queue.
  UNKNOWN
  /// The provider's window closed unapproved (or TTL passed on a request the
  /// provider provably lost) — the dunning path, distinctly labeled.
  EXPIRED
  /// Superseded before resolution (another rail paid the week first).
  CANCELLED
}

/// markedUpPrice/markup* fields are V1 dormant (zero-commission) — kept
/// equal to base until the Steps 6-7 rebuild removes them.
model OrderItem {
  id                  String            @id @default(cuid())
  orderId             String
  order               Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// ADR [SWIFT-AUD-D5-04]: itemId is a DELIBERATE loose reference — NO FK to
  /// Item, by design. name + every price below are SNAPSHOTTED at order time
  /// so a delivered order's receipt/totals never change when the vendor later
  /// edits or deletes the menu item. A cascade FK would destroy order history;
  /// a SetNull FK would null the breadcrumb a dispute may need. The id stays
  /// only as a soft pointer back to the (possibly-changed) live item.
  itemId              String
  name                String
  quantity            Int
  basePrice           Decimal           @db.Decimal(10, 2)
  markedUpPrice       Decimal           @db.Decimal(10, 2)
  markupAmount        Decimal           @db.Decimal(10, 2)
  totalBase           Decimal           @db.Decimal(10, 2)
  totalMarkup         Decimal           @db.Decimal(10, 2)
  totalCustomer       Decimal           @db.Decimal(10, 2)
  selectedOptions     OrderItemOption[]
  specialInstructions String?

  // Grocery picking (§5.3): staff tick lines as they shelf-pick; an
  // out-of-stock line becomes a substitution the CUSTOMER approves, or a
  // line refund. PENDING blocks Mark-ready; picking rides inside PREPARING —
  // no new order status (the state machine is locked).
  picked           Boolean            @default(false)
  subStatus        SubstitutionStatus @default(NONE)
  substituteItemId String?
  substituteName   String?
  substitutePrice  Decimal?           @db.Decimal(10, 2)

  @@map("order_items")
}

enum SubstitutionStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

/// Reasoned inventory movements (spec §5.6) — the paper trail behind
/// quantity_on_hand. Checkout decrements/cancel restocks stay implicit (they
/// ride the order itself); this logs the HUMAN and picking-driven changes.
model StockAdjustment {
  id        String                @id @default(cuid())
  itemId    String
  item      Item                  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  delta     Int
  reason    StockAdjustmentReason
  note      String?
  createdBy String?
  createdAt DateTime              @default(now())

  @@index([itemId, createdAt])
  @@map("stock_adjustments")
}

enum StockAdjustmentReason {
  RECEIVED
  DAMAGED
  MANUAL
  RECONCILE
  RETURN
}

model OrderItemOption {
  id              String    @id @default(cuid())
  orderItemId     String
  orderItem       OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  optionGroupName String
  optionName      String
  basePrice       Decimal   @db.Decimal(10, 2)
  markedUpPrice   Decimal   @db.Decimal(10, 2)
  markupAmount    Decimal   @db.Decimal(10, 2)

  @@map("order_item_options")
}

/// The locked model's immutable OrderEvent log. Append-only by convention:
/// no update/delete code path may exist for this model (enforced in the order's
/// state machine; rows are evidence for cash disputes and claims).
model OrderStatusLog {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  changedBy String?
  createdAt DateTime    @default(now())

  // Read on every order-detail / timeline open via the statusHistory relation.
  // This append-only dispute log becomes the largest table in the DB, so the FK
  // must be indexed (Prisma doesn't auto-index FKs); createdAt serves the
  // ORDER BY the timeline includes use. (SWIFT-AUD-D6-03: was a full seq-scan.)
  @@index([orderId, createdAt])
  @@map("order_status_logs")
}

// ==========================================
// RATINGS
// ==========================================

model Rating {
  id          String     @id @default(cuid())
  orderId     String
  raterId     String
  rater       User       @relation("raterRatings", fields: [raterId], references: [id])
  rateeId     String?
  ratee       User?      @relation("rateeRatings", fields: [rateeId], references: [id])
  vendorId    String?
  type        RatingType
  score       Int
  comment     String?
  tags        String[]
  isPublic    Boolean    @default(true)
  /// Operator's public reply (master plan §4.1 "see ratings, respond") —
  /// written once per review by MANAGER+, editable, shown on the storefront.
  response    String?
  respondedAt DateTime?
  respondedBy String?
  /// Anti-manipulation (spec §5.2): flagged for review by the daily sweep
  flagged     Boolean    @default(false)
  flagReason  String?
  /// Double-blind release (marketplace §1): the WRITTEN rating stays hidden
  /// from the ratee until both sides have rated this order, or the daily
  /// sweep releases it after the blind window. Aggregates update immediately.
  visibleAt   DateTime?
  createdAt   DateTime   @default(now())

  // --- Movement R (#18) additive columns — the live model EXTENDED, never
  // --- rebuilt (divergence logged: the spec's fresh Rating shape maps here).
  /// ACTIVE counts; EXCLUDED = shielded/admin-excluded (kept, uncounted);
  /// REMOVED = moderation takedown (gone from public, kept for audit).
  state         RatingState @default(ACTIVE)
  /// SLA_SHIELD | PLATFORM_FAULT | FRAUD_BAN | ADMIN_<code> | MODERATION
  stateReason   String?
  /// Edit window closes here (RATING_WINDOW_DAYS); null = legacy row.
  editableUntil DateTime?
  /// Rides/jobs/courier contexts (orders keep orderId): RIDE | SERVICE_JOB…
  contextType   String?
  contextId     String?

  @@unique([orderId, raterId, type], map: "ratings_one_per_context")
  @@index([visibleAt])
  @@index([raterId])
  @@index([vendorId])
  @@index([rateeId])
  @@index([flagged])
  @@index([state])
  @@map("ratings")
}

enum RatingState {
  ACTIVE
  EXCLUDED
  REMOVED
}

/// Movement R: the materialized aggregate — the ONLY thing UIs read. Written
/// incrementally on every rating change AND by the nightly full recompute;
/// the two must land identical (RAT-H) or the pipeline is lying.
model ActorRatingStat {
  id              String    @id @default(cuid())
  tenantId        String    @default("swift-default")
  subjectRole     String // VENDOR | RIDER | DRIVER | SERVICE_PROVIDER | CUSTOMER
  subjectId       String
  lifetimeCount   Int       @default(0)
  lifetimeSum     Int       @default(0)
  rollingCount    Int       @default(0)
  rollingSum      Int       @default(0)
  /// Bayesian display (null until lifetimeCount ≥ RATING_MIN_DISPLAY).
  displayRating   Decimal?  @db.Decimal(2, 1)
  standing        String    @default("NEW") // EXCELLENT | GOOD | ATTENTION | AT_RISK | NEW
  topPositiveTags Json      @default("[]")
  topNegativeTags Json      @default("[]")
  /// Last daily actor-visible fold (anonymity law R5).
  actorVisibleAt  DateTime?
  recomputedAt    DateTime  @default(now())

  @@unique([tenantId, subjectRole, subjectId])
  @@map("actor_rating_stats")
}

/// Movement R: review reports → the founder's moderation queue.
model RatingReport {
  id         String    @id @default(cuid())
  tenantId   String    @default("swift-default")
  ratingId   String
  reporterId String
  reason     String // OFFENSIVE | FALSE_CLAIM | PRIVATE_INFO | SPAM | OTHER
  note       String?
  status     String    @default("PENDING") // PENDING | UPHELD | DISMISSED
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, status])
  @@map("rating_reports")
}

/// Movement R: Uber-style per-item thumbs — feeds the vendor insights Pareto.
model ItemFeedback {
  id          String   @id @default(cuid())
  tenantId    String   @default("swift-default")
  orderId     String
  itemId      String
  raterUserId String
  verdict     String // UP | DOWN
  createdAt   DateTime @default(now())

  @@unique([orderId, itemId, raterUserId])
  @@index([tenantId, itemId, verdict])
  @@map("item_feedbacks")
}

/// Movement R: the tag taxonomy (R4) — seeded exactly, per subject role,
/// admin-editable labels, immutable slugs, positive/negative sentiment sets.
model RatingTagDef {
  id        String  @id @default(cuid())
  tenantId  String  @default("swift-default")
  role      String // VENDOR | RIDER | DRIVER | SERVICE_PROVIDER | CUSTOMER
  slug      String
  label     String
  sentiment String // POSITIVE | NEGATIVE
  isSeed    Boolean @default(true)

  @@unique([tenantId, role, slug])
  @@map("rating_tag_defs")
}

/// Retail returns/disputes (spec §4.5) — retail has returns, food doesn't.
model ReturnRequest {
  id             String       @id @default(cuid())
  orderId        String
  customerId     String
  reason         String
  status         ReturnStatus @default(REQUESTED)
  resolutionNote String?
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@map("return_requests")
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

// ==========================================
// SERVICES (hire verified professionals — spec §4.6)
// ==========================================

model ServiceProvider {
  id              String                 @id @default(cuid())
  userId          String                 @unique
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade           String
  bio             String?
  portfolioPhotos String[]
  /// Transparency (§4.6): true until a qualification is added — shown to customers.
  selfSkilled     Boolean                @default(true)
  /// Listable + can accept jobs only when ID + police clearance are approved.
  isVerified      Boolean                @default(false)
  averageRating   Float                  @default(5)
  totalRatings    Int                    @default(0)
  qualifications  ServiceQualification[]
  jobs            ServiceJob[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([trade])
  @@map("service_providers")
}

model ServiceQualification {
  id              String              @id @default(cuid())
  providerId      String
  provider        ServiceProvider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  /// Canonical service-trade ID at submission/review time. Null identifies a
  /// legacy credential with no trustworthy trade provenance; it cannot badge.
  trade           String?
  type            QualificationType
  referenceNumber String?
  status          QualificationStatus @default(PENDING)
  verifiedAt      DateTime?
  createdAt       DateTime            @default(now())

  @@index([providerId])
  @@index([providerId, trade, status])
  @@map("service_qualifications")
}

/// One hire of one provider. Double-booking a provider is impossible at the
/// data layer: a partial unique index on ("providerId", "scheduledFor") WHERE
/// the job is live — status SCHEDULED or IN_PROGRESS and a slot is actually
/// held — see the 20260826000000_service_job_slot_exclusivity migration
/// (Prisma cannot express partial uniques, so it lives in SQL). COMPLETED and
/// CANCELLED jobs are history and release the slot; decline-slot releases it by
/// clearing scheduledFor. A job carries a start and no duration, so only an
/// IDENTICAL start collides — overlap needs a duration field [reported].
model ServiceJob {
  id                  String           @id @default(cuid())
  customerId          String
  customer            User             @relation("customerServiceJobs", fields: [customerId], references: [id])
  providerId          String
  provider            ServiceProvider  @relation(fields: [providerId], references: [id])
  description         String
  photos              String[]
  status              ServiceJobStatus @default(REQUESTED)
  quoteAmount         Decimal?         @db.Decimal(12, 2)
  scheduledFor        DateTime?
  /// Booking accept/decline (master plan §4.3): the provider confirms the
  /// customer's slot. Null on a SCHEDULED job = awaiting confirmation.
  providerConfirmedAt DateTime?
  chatRoomId          String?
  completedAt         DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([customerId])
  @@index([providerId])
  @@index([status])
  @@map("service_jobs")
}

enum ServiceJobStatus {
  REQUESTED
  QUOTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum QualificationType {
  GEI_LICENCE
  CVQ
  GTEE
  CITY_AND_GUILDS
  OTHER
}

enum QualificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum RatingType {
  CUSTOMER_TO_VENDOR
  CUSTOMER_TO_RIDER
  CUSTOMER_TO_DRIVER
  RIDER_TO_CUSTOMER
  DRIVER_TO_CUSTOMER
  CUSTOMER_TO_PROVIDER
  PROVIDER_TO_CUSTOMER
}

// ==========================================
// SUBSCRIPTIONS
// ==========================================

model Subscription {
  id                 String                @id @default(cuid())
  riderId            String?               @unique
  rider              Rider?                @relation(fields: [riderId], references: [id])
  driverId           String?               @unique
  driver             Driver?               @relation(fields: [driverId], references: [id])
  vendorId           String?               @unique
  vendor             Vendor?               @relation(fields: [vendorId], references: [id])
  type               SubscriptionType
  status             SubscriptionStatus    @default(ACTIVE)
  weeklyRate         Decimal               @db.Decimal(10, 2)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  nextBillingDate    DateTime
  isInGracePeriod    Boolean               @default(false)
  gracePeriodEnd     DateTime?
  isTrialActive      Boolean               @default(false)
  trialEndDate       DateTime?
  autoRenew          Boolean               @default(true)
  lastPaymentDate    DateTime?
  lastPaymentId      String?
  failedAttempts     Int                   @default(0)
  payments           SubscriptionPayment[]
  refunds            SubscriptionRefund[]
  feeWaived          Boolean               @default(false)
  feeWaivedBy        String?
  feeWaivedReason    String?
  customRate         Decimal?              @db.Decimal(10, 2)

  /// Locked model: currency from CountryConfig; auto-suspend on non-payment
  currencyCode       String          @default("GYD")
  autoSuspendEnabled Boolean         @default(true)
  prepaidBalance     PrepaidBalance?

  /// How this subscription pays: CASH = prepaid balance path; CARD = stored
  /// token; MOBILE_MONEY = MMG merchant-initiated request the subscriber
  /// approves on their phone (§13 dual-rail — card primary, MMG fallback)
  billingMethod  PaymentMethod @default(CASH)
  /// Tokenized card reference from the PaymentProvider — never raw card data
  paymentToken   String?
  /// The subscriber's MMG account (MSISDN) merchant-initiated requests charge
  mmgPayerMsisdn String?
  /// Failed charges retry on a daily cadence, not every job run
  nextRetryAt    DateTime?
  /// When auto-suspend cut access (§11 dunning) — the churn clock reads this;
  /// cleared on reinstatement.
  suspendedAt    DateTime?

  /// Swift Account Number [san spec PART 2] — the universal payment reference
  /// for platform fees across every rail (agent cash / checkout / card).
  /// 10 digits, Luhn-checked, IMMUTABLE: never changes, never re-issued,
  /// never recycled (SanTombstone). A payment address, NOT an auth factor,
  /// never an entity id in URLs. Format CHECK lives in raw migration SQL.
  san           String?   @unique @db.Char(10)
  sanAssignedAt DateTime?

  billingEvents BillingEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([nextBillingDate])
  @@map("subscriptions")
}

/// Immutable billing audit log — every money event, append-only.
/// idempotencyKey is the double-charge guard: one CHARGE_ATTEMPT per
/// subscription per period per retry level, enforced at the database.
model BillingEvent {
  id             String           @id @default(cuid())
  subscriptionId String
  subscription   Subscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  type           BillingEventType
  amount         Decimal?         @db.Decimal(12, 2)
  currencyCode   String           @default("GYD")
  idempotencyKey String           @unique
  /// PaymentProvider charge/refund reference when one exists
  paymentRef     String?
  note           String?
  /// USD pricing (System 2): the pinned trio. `amount` = the local settlement
  /// figure; these record the USD price + the exact rate that produced it.
  /// Nullable — pre-USD events and non-charge events carry none.
  amountUsd      Decimal?         @db.Decimal(10, 2)
  fxRateId       String?
  fxRateUsed     Decimal?         @db.Decimal(12, 6)
  createdAt      DateTime         @default(now())

  @@index([subscriptionId])
  @@index([type])
  @@map("billing_events")
}

enum BillingEventType {
  CHARGE_ATTEMPT
  CHARGE_SUCCESS
  CHARGE_FAILED
  PREPAID_TOPUP
  SUSPENDED
  REINSTATED
  REMINDER
  TIER_CHANGE
  CHURNED
}

/// An inbound platform-fee payment [san spec PART 4] — every channel, one
/// pipeline. NEVER REJECT REAL MONEY (SO-6): by the time Swift hears about
/// it, cash already left someone's hand at an agent counter — resolution
/// failures land here as UNMATCHED with a diagnosis, never a 4xx. Amounts are
/// exact Decimal GYD major units, matching the incumbent billing engine
/// (PrepaidBalance/BillingEvent) — a BigInt-minor island inside a Decimal
/// engine would be the conversion-bug factory the money laws exist to prevent.
model MmgAgentPayment {
  id             String    @id @default(cuid())
  /// MMG_AGENT_WEBHOOK | MMG_SETTLEMENT_FILE | MANUAL_ADMIN
  channel        String
  /// Idempotency key within the channel (MMG txn id / file row id / MANUAL:<receipt>)
  externalId     String
  /// Normalized MMG transaction id — cross-CHANNEL dedupe (webhook + file = one credit)
  mmgTxnId       String?
  sanRaw         String
  sanNormalized  String?   @db.Char(10)
  tenantId       String    @default("swift-default")
  subscriptionId String?
  amount         Decimal   @db.Decimal(12, 2)
  currencyCode   String    @db.Char(3)
  paidAt         DateTime
  agentRef       String?
  payerMsisdn    String?
  /// RECEIVED | MATCHED | UNMATCHED | RECONCILED | RESOLVED | REFUND_FLAGGED
  status         String
  /// SAN_MALFORMED | SAN_CHECKSUM_FAILED | SAN_UNKNOWN | ACCOUNT_CLOSED | TOMBSTONED | BAD_CURRENCY | AMOUNT_OUT_OF_RANGE
  failureCode    String?
  raw            Json
  resolvedBy     String?
  resolvedAt     DateTime?
  note           String?
  createdAt      DateTime  @default(now())

  @@unique([channel, externalId])
  @@index([status, createdAt])
  @@index([sanNormalized])
  @@map("mmg_agent_payments")
}

/// Bank-truth reconciliation [san spec PART 25]: ledger truth vs what MMG
/// actually deposited, minus their fees. INERT until the settlement cadence
/// config is set (MMG question 10) — built now, activated by an answer.
model SettlementBatch {
  id             String    @id @default(cuid())
  tenantId       String    @default("swift-default")
  provider       String    @default("MMG")
  periodStart    DateTime
  periodEnd      DateTime
  /// Σ MATCHED/RESOLVED agent payments in period — computed, provable from rows
  grossGyd       Decimal   @db.Decimal(12, 2)
  providerFeeGyd Decimal?  @db.Decimal(12, 2)
  expectedNetGyd Decimal?  @db.Decimal(12, 2)
  depositedGyd   Decimal?  @db.Decimal(12, 2)
  depositedAt    DateTime?
  bankRef        String?
  /// EXPECTED | DEPOSITED | MISMATCH | RESOLVED
  status         String    @default("EXPECTED")
  notes          String?
  createdAt      DateTime  @default(now())

  @@unique([tenantId, provider, periodStart])
  @@index([status])
  @@map("settlement_batches")
}

/// GRA-ready sequential receipts [san spec 20.1]: per-tenant-per-year gapless
/// counter, one receipt per credit (cash, manual, promo — promo shows GY$0
/// cash). Financial rows survive DPA erasure (legal-obligation basis, 20.5).
model FeeReceipt {
  id             String   @id @default(cuid())
  receiptNumber  String   @unique // SWF-{TENANT}-{YYYY}-{000001}
  tenantId       String   @default("swift-default")
  subscriptionId String
  billingEventId String   @unique
  amount         Decimal  @db.Decimal(12, 2)
  channel        String?
  mmgRef         String?
  issuedAt       DateTime @default(now())

  @@index([subscriptionId, issuedAt])
  @@index([tenantId, issuedAt])
  @@map("fee_receipts")
}

/// The gapless counter behind FeeReceipt — row-locked per issue [scenario R].
model ReceiptCounter {
  tenantId String
  year     Int
  seq      Int    @default(0)

  @@id([tenantId, year])
  @@map("receipt_counters")
}

/// Collections workbench [san spec PART 21]: the founder's call log. A missed
/// promise resurfaces the row; promise-kept rate is a KPI.
model CollectionContact {
  id             String    @id @default(cuid())
  subscriptionId String
  outcome        String // REACHED | PROMISED | REFUSED | WRONG_NUMBER
  promisedDate   DateTime?
  note           String?
  byAdminId      String
  createdAt      DateTime  @default(now())

  @@index([subscriptionId, createdAt])
  @@map("collection_contacts")
}

/// A released Swift Account Number, kept forever [san spec 2.4]: on account
/// erasure the subscription row may be anonymized but its SAN lands here —
/// a late agent payment to it goes to suspense, never to a stranger, and the
/// number can never be drawn again.
model SanTombstone {
  san            String   @id @db.Char(10)
  subscriptionId String
  tenantId       String   @default("swift-default")
  reason         String?
  releasedAt     DateTime @default(now())

  @@map("san_tombstones")
}

/// [F-026-02] Durable census of storage objects still owed a deletion —
/// failed unwind/account-deletion deletes and replaced selfie pointers.
/// One open row per key (upsert re-opens); purgedAt closes it. Retried
/// opportunistically at account deletion; IDV-1 Phase 2 owns the sweeper.
model StorageOrphan {
  id        String    @id @default(cuid())
  tenantId  String    @default("swift-default")
  key       String    @unique
  reason    String
  userId    String?
  createdAt DateTime  @default(now())
  purgedAt  DateTime?

  @@index([tenantId, purgedAt])
  @@map("storage_orphans")
}

/// Prepaid path for cash payers: agents/bank-transfer top-ups recorded by
/// admin; the weekly billing job deducts from here before suspending.
/// Floor-at-zero CHECK lives in raw migration SQL [tollgate 3.1].
model PrepaidBalance {
  id             String       @id @default(cuid())
  subscriptionId String       @unique
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  balance        Decimal      @default(0) @db.Decimal(12, 2)
  currencyCode   String       @default("GYD")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("prepaid_balances")
}

/// TOLLGATE PART 17 — double-entry ledger. Every fee-money movement posts a
/// balanced transaction here IN THE SAME database transaction as the mutation;
/// wallet balances are projections and the nightly invariant proves
/// projection == ledger (S0 page on drift). Reference chart of accounts —
/// seeded by migration; the in-code map in modules/billing/ledger.ts is the
/// source of truth (no FK from entries: tests run on bare `db push`).
model LedgerAccount {
  code         String   @id // stable: CLEARING_MMG, WALLET_LIABILITY, FEE_REVENUE, ...
  name         String
  type         String // ASSET | LIABILITY | REVENUE | EXPENSE | CONTRA
  currencyCode String   @default("GYD")
  createdAt    DateTime @default(now())

  @@map("ledger_accounts")
}

/// One balanced money event. INSERT-only at the database (append-only trigger
/// in raw migration SQL) — corrections are reversing transactions referencing
/// the original, never edits. idempotencyKey makes every posting path
/// replay-safe at the DB [tollgate LAW M-4].
model LedgerTransaction {
  id             String        @id @default(cuid())
  idempotencyKey String        @unique
  description    String
  occurredAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())
  entries        LedgerEntry[]

  @@index([occurredAt])
  @@map("ledger_transactions")
}

/// Exactly one of debit/credit is nonzero and nonnegative per row (DB CHECKs);
/// Σdebit = Σcredit per transaction (deferred DB constraint trigger, proven by
/// tests that try to break it). Decimal GYD major units like every other money
/// column — see the MmgAgentPayment comment for why no BigInt-minor island.
model LedgerEntry {
  id            String            @id @default(cuid())
  transactionId String
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])
  accountCode   String
  /// Subledger dimension — subscriptionId for WALLET_LIABILITY rows
  subledgerId   String?
  debit         Decimal           @default(0) @db.Decimal(12, 2)
  credit        Decimal           @default(0) @db.Decimal(12, 2)

  @@index([accountCode, subledgerId])
  @@index([transactionId])
  @@map("ledger_entries")
}

enum SubscriptionType {
  DELIVERY_RIDER
  COURIER_RIDER
  TAXI_DRIVER
  RESTAURANT
  SUPERMARKET
  RETAIL_STORE
  SERVICE_PROVIDER
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  PAST_DUE
  SUSPENDED
  CANCELLED
  TRIAL
  CHURNED // suspended past SUSPENSION_MAX_DAYS (§11) — terminal; dunning stops, paying rejoins
}

/// A solicited collection attempt — TOLLGATE's PaymentIntent, grown from the
/// original payment row rather than duplicated beside it (one record per
/// attempt, never two). The intent lifecycle: PENDING (live at the provider)
/// → CAPTURED | FAILED | EXPIRED, with UNKNOWN as a first-class state [LAW
/// M-5] for "money may have moved but we cannot confirm" (initiate timed out,
/// provider unreachable past TTL) — UNKNOWN is never auto-failed; it ages
/// into the admin queue and resolves by poller, portal check, or settlement.
model SubscriptionPayment {
  id             String               @id @default(cuid())
  subscriptionId String
  subscription   Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount         Decimal              @db.Decimal(10, 2)
  status         PaymentStatus
  paymentMethod  PaymentMethod
  externalRef    String?
  periodStart    DateTime
  periodEnd      DateTime
  paidAt         DateTime?
  createdAt      DateTime             @default(now())
  refunds        SubscriptionRefund[]

  /// Swift's correlation id, sent to the provider as the merchant reference —
  /// the retry-safe key that survives even when the provider's own id never
  /// came back (initiate timeout → UNKNOWN with clientKey, no externalRef).
  clientKey      String?   @unique
  /// WEEKLY_FEE | PREPAY | REINSTATE
  purpose        String    @default("WEEKLY_FEE")
  /// Normalized failure taxonomy [tollgate 5.2] — dunning branches on THIS,
  /// never on provider-native strings.
  failureCode    String?
  failureRaw     Json?
  /// Provider TTL when known; defaults to createdAt+24h (the Q2 register
  /// answer replaces the default, not the mechanism).
  expiresAt      DateTime?
  lastPolledAt   DateTime?
  pollBackoffSec Int       @default(30)

  @@index([status, lastPolledAt])
  @@map("subscription_payments")
}

// ==========================================
// EARNINGS & SETTLEMENTS
// ==========================================

model Earning {
  id        String        @id @default(cuid())
  riderId   String?
  rider     Rider?        @relation(fields: [riderId], references: [id])
  driverId  String?
  driver    Driver?       @relation(fields: [driverId], references: [id])
  orderId   String
  type      EarningType
  amount    Decimal       @db.Decimal(10, 2)
  status    EarningStatus @default(PENDING)
  createdAt DateTime      @default(now())

  // One earning per (order, type): a mover's fee/fare/tip for an order is a
  // single fact. This makes createEarnings idempotent — two concurrent order
  // completions can't double-pay (createMany skipDuplicates relies on it).
  @@unique([orderId, type])
  @@index([status])
  @@index([riderId])
  @@index([driverId])
  @@map("earnings")
}

/// In-app support / dispute channel (replaces a mailto). A customer, mover, or
/// vendor opens a ticket — optionally tied to an order — every open ticket
/// pings the admins, and an admin resolves it. The customer sees their tickets
/// and their status. Chat/reply threading is a later step; this is the
/// report → acknowledge → resolve loop launch actually needs.
model SupportTicket {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  orderId      String?
  order        Order?          @relation(fields: [orderId], references: [id])
  category     SupportCategory
  subject      String
  message      String
  status       SupportStatus   @default(OPEN)
  adminNote    String?
  resolvedById String?
  resolvedBy   User?           @relation("supportResolver", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId])
  @@index([status])
  @@index([orderId])
  @@map("support_tickets")
}

enum SupportCategory {
  ORDER_ISSUE
  PAYMENT
  SAFETY
  ACCOUNT
  VENDOR
  MOVER
  OTHER
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum EarningType {
  DELIVERY_FEE
  COURIER_FEE
  TAXI_FARE
  TIP
}

enum EarningStatus {
  PENDING
  AVAILABLE
  PAID_OUT
}

model Settlement {
  id          String           @id @default(cuid())
  vendorId    String
  vendor      Vendor           @relation(fields: [vendorId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  totalOrders Int
  totalBase   Decimal          @db.Decimal(12, 2)
  totalMarkup Decimal          @db.Decimal(12, 2)
  status      SettlementStatus @default(PENDING)
  paidAt      DateTime?
  reference   String?
  createdAt   DateTime         @default(now())

  @@map("settlements")
}

enum SettlementStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

/// MMG direct-pay: for an MMG-paid DELIVERY the customer paid the STORE (not
/// the rider), so the store owes the rider the delivery fee IN CASH. Swift only
/// tracks the debt until both sides confirm the handover — it moves no money.
enum CashSettlementStatus {
  OWED
  RIDER_CONFIRMED
  STORE_CONFIRMED
  SETTLED
}

model DeliveryCashSettlement {
  id               String               @id @default(cuid())
  orderId          String               @unique
  order            Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  riderId          String
  rider            Rider                @relation(fields: [riderId], references: [id])
  vendorId         String
  vendor           Vendor               @relation(fields: [vendorId], references: [id])
  /// Delivery pay the store owes the rider (GYD): delivery fee PLUS any
  /// prepaid tip — the customer's MMG payment landed both in the store's
  /// wallet [REPORT-005/006 carryover: "fee" alone under-describes the debt].
  amount           Decimal              @db.Decimal(10, 2)
  status           CashSettlementStatus @default(OWED)
  riderConfirmedAt DateTime?
  storeConfirmedAt DateTime?
  createdAt        DateTime             @default(now())

  @@index([riderId, status])
  @@index([vendorId, status])
  @@map("delivery_cash_settlements")
}

// ==========================================
// TRANSACTIONS & WALLET
// V1 dormant — cash-only. Swift never holds order money.
// Kept ledger-shaped for the Part C wallet rework; do not build V1 features on
// Transaction / walletBalance / PayoutRequest / PayoutSchedule.
// ==========================================

model Transaction {
  id           String          @id @default(cuid())
