# Swift mobile — every EXPO_PUBLIC_ var ships INSIDE the app bundle.
# Publishable/ingestion keys only; anything privileged stays on the API.

# API origin (defaults: localhost:3000 in dev, https://api.swift.gy in release)
EXPO_PUBLIC_API_URL=

# Public links are a separate boundary from the API.  Production is exactly
# https://swiftgy.com; preview links stay disabled unless a separately audited
# preview host is supplied in the EAS profile.  Do not point either value at
# api.swift.gy, swift.gy, a path, or an arbitrary hostname.
EXPO_PUBLIC_LINK_ENV=
EXPO_PUBLIC_WEB_URL=
EXPO_PUBLIC_LINK_PREVIEW_HOSTS=
SWIFT_LINK_DOMAIN=swiftgy.com

# Product analytics is DISABLED (SWIFT-AUD-D9-01) pending DPA-compliant
# disclosure + consent. Re-add a config block here only when re-enabling it.

# BUILD-TIME only (read by app.config.ts at prebuild/EAS, not shipped as env):
# Android maps key — react-native-maps on Android is Google-backed and shows a
# blank map without it. Restrict to package gy.swift.app + your keystore SHA-1.
ANDROID_GOOGLE_MAPS_API_KEY=

# EAS project id — links builds/updates to your EAS project (app.config.ts:105
# sets extra.eas.projectId when present). From `eas init` / the Expo dashboard.
EAS_PROJECT_ID=

# ── Shipping to the App Store / TestFlight ──────────────────────────────────
# The Apple Team ID lives in eas.json — it is public by design (it is published
# in /.well-known/apple-app-site-association) and authorises nothing on its own.
#
# The Apple ID is NOT there, deliberately: it is the login for the account that
# holds the signing certificates, and this repository is public. `eas submit`
# prompts for it, or reads it from here. Keep this file out of git (.env.local).
EXPO_APPLE_ID=

# The App Store Connect app id. There is none until the app record exists:
#   appstoreconnect.apple.com → Apps → + → New App
#     Platform  iOS
#     Name      Swift
#     Bundle ID gy.swift.app        (register it first at
#                                    developer.apple.com → Identifiers, or let
#                                    the first `eas build` create it)
#     SKU       anything unique, e.g. swift-gy
# The id is then the number in the App Store Connect URL. `eas submit` can also
# resolve it from the bundle identifier, so this is optional.
ASC_APP_ID=
