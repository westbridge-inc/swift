# Swift mobile — every EXPO_PUBLIC_ var ships INSIDE the app bundle.
# Publishable/ingestion keys only; anything privileged stays on the API.

# API origin (defaults: localhost:3000 in dev, https://api.swift.gy in release)
EXPO_PUBLIC_API_URL=

# Product analytics is DISABLED (SWIFT-AUD-D9-01) pending DPA-compliant
# disclosure + consent. Re-add a config block here only when re-enabling it.

# BUILD-TIME only (read by app.config.ts at prebuild/EAS, not shipped as env):
# Android maps key — react-native-maps on Android is Google-backed and shows a
# blank map without it. Restrict to package gy.swift.app + your keystore SHA-1.
ANDROID_GOOGLE_MAPS_API_KEY=
