{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swift Mission Control",
  "version": "0.1.0",
  "identifier": "gy.swift.missioncontrol",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Swift Mission Control",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "transparent": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' http://localhost:3000 https://api.swift.gy data:; frame-src 'self' http://localhost:3000 https://api.swift.gy; connect-src 'self' ipc: http://ipc.localhost http://localhost:3000 https://api.swift.gy wss://api.swift.gy"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
