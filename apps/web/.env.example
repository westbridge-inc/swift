# Swift web (customer/vendor storefront, Next.js). Copy to `.env.local`.
# NEXT_PUBLIC_ vars are inlined into the client bundle — publishable only.

# API origin the browser calls. Dev default: http://localhost:3000.
# Set to your deployed API (e.g. https://api.swift.gy) for staging/prod.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Server-side rewrite target (defaults to NEXT_PUBLIC_API_URL when unset).
# API_URL=http://localhost:3000

# Dev server port (Next default 3000; set if it clashes with the API).
# PORT=3001
