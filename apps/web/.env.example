# Swift web (customer/vendor storefront, Next.js). Copy to `.env.local`.
# NEXT_PUBLIC_ vars are inlined into the client bundle — publishable only.

# API origin the browser calls. Leave unset in local development: the web app
# uses exactly http://localhost:3000. A production build REQUIRES the one
# canonical release origin, https://api.<site domain> (see src/site.domain.ts),
# and refuses anything else — a build handed no origin, a plaintext origin,
# a path or a different host does not build.
# NEXT_PUBLIC_API_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=https://api.swiftgy.com

# Server-side rewrite target (defaults to NEXT_PUBLIC_API_URL when unset).
# API_URL=http://localhost:3000

# Dev server port (Next default 3000; set if it clashes with the API).
# PORT=3001

# ── Deep links: making a printed QR code open the APP ────────────────────────
# Both files below 404 until their variable is set — an honest absence, never a
# fake association. While they 404, a QR code or a shared storefront link opens
# a BROWSER TAB on a phone that has Swift installed, and nothing reports it.
#
# /.well-known/apple-app-site-association
#   APPLE_TEAM_ID   — the 10-character Team ID from your Apple Developer
#                     account (developer.apple.com → Membership details).
#   APPLE_BUNDLE_ID — defaults to gy.swift.app; set only if that changes.
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=
#
# /.well-known/assetlinks.json
#   ANDROID_CERT_SHA256 — the RELEASE keystore's SHA-256 fingerprint,
#                         colon-separated (comma-separate several).
#                         From Play Console → Setup → App signing.
#   ANDROID_PACKAGE     — defaults to gy.swift.app.
ANDROID_CERT_SHA256=
ANDROID_PACKAGE=
#
# The domain both files are served from, and that the app claims in its
# associatedDomains / intent filters. Must match, or neither will verify.
SWIFT_LINK_DOMAIN=swiftgy.com
