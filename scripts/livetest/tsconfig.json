{
  "//": "Type-check only (the runner executes under tsx): apps/api/node_modules/.bin/tsc -p scripts/livetest",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "typeRoots": ["../../apps/api/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["./**/*.ts"]
}
